<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.7" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      SixLabors.ImageSharp (3.1.6, Apache-2.0) is used by the texture tests to decode written
      PNGs. It is referenced transitively through AquaModelLibrary.Data and deliberately NOT
      added as a direct PackageReference: the repo audits direct dependencies only, and this
      library-pinned version carries known advisories we do not want to surface as warnings
      (see Directory.Build.props).
    -->
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BpConvert.Core\BpConvert.Core.csproj" />
  </ItemGroup>

</Project>