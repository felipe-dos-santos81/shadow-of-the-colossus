<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.7" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      SixLabors.ImageSharp (3.1.6, Six Labors Split License) is used by the texture tests to decode
      written PNGs. It is referenced transitively through AquaModelLibrary.Data (a direct
      PackageReference of that GPL-3.0 submodule) and is deliberately NOT added as a direct
      PackageReference here: it is not pinned by this project, and the library-pinned version
      carries known advisories we do not want to surface as warnings (see Directory.Build.props).
      Note it IS present in the product graph — its DLL ships in the published CLI output — so the
      personal-use/no-redistribution terms of the Six Labors Split License apply to the product
      build too (see tools/native/NOTICE.md).
    -->
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BpConvert.Core\BpConvert.Core.csproj" />
  </ItemGroup>

</Project>