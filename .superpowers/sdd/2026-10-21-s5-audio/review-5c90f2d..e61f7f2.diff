+using System.Globalization;
+using System.Text;
+
+namespace BpConvert.Core.Audio;
+
+/// <summary>
+/// One line of <c>audio.manifest</c> (ruling R1): the decoded clip's identity, its WAV path
+/// relative to the library root, and the measured PCM facts. The viewer loads the manifest and
+/// never opens a <c>.sxd</c>.
+/// </summary>
+/// <param name="Bank">Source bank name, e.g. <c>boss01</c> or <c>music</c>.</param>
+/// <param name="Name">Clip name — the curated event key, e.g. <c>valus.impact</c>.</param>
+/// <param name="File">
+/// WAV path relative to the library root with forward slashes, e.g.
+/// <c>audio/boss01/valus.impact.wav</c>.
+/// </param>
+/// <param name="Rate">Measured sample rate (48 000).</param>
+/// <param name="Channels">1 or 2 (5.1 was downmixed at conversion time, ruling R6).</param>
+/// <param name="Frames">Measured per-channel frame count (not the record's declared count).</param>
+/// <param name="Seconds">Measured duration, <paramref name="Frames"/> / <paramref name="Rate"/>.</param>
+/// <param name="Codec">Source codec: <c>at9</c>, <c>psadpcm</c>, or <c>mixed</c> for a layer mix.</param>
+/// <param name="Loop">True for the streamed music tracks.</param>
+/// <param name="GainDb">
+/// The attenuation <see cref="AudioCodec.Normalize"/> applied when bringing the clip to peak
+/// ≤ 0.99 (0 when no scaling was needed). Informational: the WAV is already normalized.
+/// </param>
+public sealed record AudioEntry(
+    string Bank, string Name, string File, int Rate, int Channels, long Frames, double Seconds,
+    string Codec, bool Loop, double GainDb);
+
+/// <summary>
+/// Reads and writes the line-based <c>audio.manifest</c> (ruling R1):
+/// <code>
+/// version=1
+/// name=valus.impact bank=boss01 file=audio/boss01/valus.impact.wav rate=48000 channels=2 frames=362068 seconds=7.543083 codec=psadpcm loop=0 gain_db=-0.0864
+/// </code>
+/// One entry per line, keys in that order, sorted by <c>(bank, name)</c>. Values are
+/// space-free: the clip name is the curated event key, so the <c>key=value</c> pairs stay
+/// unambiguous for the viewer's simple parser. The first line is <c>version=1</c>; the path key is
+/// relative to the library root (<c>out/library</c>), which is exactly what
+/// <c>AudioEngine::load_manifest(manifestPath, libraryRoot)</c> receives.
+/// </summary>
+public static class AudioManifest
+{
+    /// <summary>The only manifest schema version this converter writes/reads.</summary>
+    public const int Version = 1;
+
+    private static readonly string[] Keys =
+    {
+        "name", "bank", "file", "rate", "channels", "frames", "seconds", "codec", "loop", "gain_db",
+    };
+
+    /// <summary>
+    /// Writes <paramref name="entries"/> sorted by <c>(bank, name)</c>, creating the parent
+    /// directory. Returns <paramref name="path"/> so a caller can log it directly.
+    /// </summary>
+    /// <exception cref="InvalidDataException">
+    /// A field is empty/out of range, a value contains whitespace (the line format is
+    /// space-separated), or two entries share a <c>(bank, name)</c> key.
+    /// </exception>
+    public static string Write(string path, IReadOnlyList<AudioEntry> entries)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(path);
+        ArgumentNullException.ThrowIfNull(entries);
+
+        var seen = new HashSet<(string Bank, string Name)>();
+        foreach (var entry in entries)
+        {
+            Validate(path, null, entry);
+            if (!seen.Add((entry.Bank, entry.Name)))
+                throw Invalid(path, $"duplicate entry {entry.Bank}/{entry.Name}");
+        }
+
+        var builder = new StringBuilder();
+        builder.Append("version=").Append(Version).Append('\n');
+        foreach (var entry in entries.OrderBy(entry => entry.Bank, StringComparer.Ordinal)
+                     .ThenBy(entry => entry.Name, StringComparer.Ordinal))
+        {
+            builder.Append("name=").Append(entry.Name)
+                .Append(" bank=").Append(entry.Bank)
+                .Append(" file=").Append(entry.File)
+                .Append(" rate=").Append(entry.Rate.ToString(CultureInfo.InvariantCulture))
+                .Append(" channels=").Append(entry.Channels.ToString(CultureInfo.InvariantCulture))
+                .Append(" frames=").Append(entry.Frames.ToString(CultureInfo.InvariantCulture))
+                .Append(" seconds=").Append(entry.Seconds.ToString("F6", CultureInfo.InvariantCulture))
+                .Append(" codec=").Append(entry.Codec)
+                .Append(" loop=").Append(entry.Loop ? '1' : '0')
+                .Append(" gain_db=").Append(entry.GainDb.ToString("0.####", CultureInfo.InvariantCulture))
+                .Append('\n');
+        }
+
+        var directory = Path.GetDirectoryName(Path.GetFullPath(path));
+        if (!string.IsNullOrEmpty(directory))
+            Directory.CreateDirectory(directory);
+        File.WriteAllText(path, builder.ToString(), new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
+        return path;
+    }
+
+    /// <summary>
+    /// Reads a manifest written by <see cref="Write"/> and returns its entries sorted by
+    /// <c>(bank, name)</c> (the on-disk order is already sorted; sorting here makes a hand-edited
+    /// file stable too).
+    /// </summary>
+    /// <exception cref="InvalidDataException">
+    /// The version line is missing/unknown, a line has an unknown/duplicate/missing key or an
+    /// unparsable value, or two entries share a <c>(bank, name)</c> key.
+    /// </exception>
+    public static IReadOnlyList<AudioEntry> Read(string path)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(path);
+
+        var lines = File.ReadAllLines(path);
+        var entries = new List<AudioEntry>(Math.Max(0, lines.Length - 1));
+        var seen = new HashSet<(string Bank, string Name)>();
+        var sawVersion = false;
+
+        for (var i = 0; i < lines.Length; i++)
+        {
+            var line = lines[i].Trim();
+            if (line.Length == 0)
+                continue;
+
+            if (!sawVersion)
+            {
+                if (line != $"version={Version}")
+                    throw Invalid(path, $"line {i + 1}: expected version={Version}, got \"{line}\"");
+                sawVersion = true;
+                continue;
+            }
+
+            var values = new Dictionary<string, string>(StringComparer.Ordinal);
+            foreach (var token in line.Split(' ', StringSplitOptions.RemoveEmptyEntries))
+            {
+                var equals = token.IndexOf('=');
+                if (equals <= 0 || equals == token.Length - 1)
+                    throw Invalid(path, $"line {i + 1}: \"{token}\" is not key=value");
+                var key = token[..equals];
+                if (Array.IndexOf(Keys, key) < 0)
+                    throw Invalid(path, $"line {i + 1}: unknown key \"{key}\"");
+                if (!values.TryAdd(key, token[(equals + 1)..]))
+                    throw Invalid(path, $"line {i + 1}: duplicate key \"{key}\"");
+            }
+
+            foreach (var key in Keys)
+                if (!values.ContainsKey(key))
+                    throw Invalid(path, $"line {i + 1}: missing key \"{key}\"");
+
+            var entry = new AudioEntry(
+                values["bank"], values["name"], values["file"],
+                ParseInt(path, i, "rate", values["rate"]),
+                ParseInt(path, i, "channels", values["channels"]),
+                ParseLong(path, i, "frames", values["frames"]),
+                ParseDouble(path, i, "seconds", values["seconds"]),
+                values["codec"],
+                ParseLoop(path, i, values["loop"]),
+                ParseDouble(path, i, "gain_db", values["gain_db"]));
+            Validate(path, $"line {i + 1}: ", entry);
+            if (!seen.Add((entry.Bank, entry.Name)))
+                throw Invalid(path, $"line {i + 1}: duplicate entry {entry.Bank}/{entry.Name}");
+            entries.Add(entry);
+        }
+
+        if (!sawVersion)
+            throw Invalid(path, "missing version=1 line");
+        return entries.OrderBy(entry => entry.Bank, StringComparer.Ordinal)
+            .ThenBy(entry => entry.Name, StringComparer.Ordinal)
+            .ToList();
+    }
+
+    private static void Validate(string path, string? location, AudioEntry entry)
+    {
+        var at = $"{location}{entry.Bank}/{entry.Name}";
+        if (entry.Bank.Length == 0 || entry.Name.Length == 0 || entry.File.Length == 0
+            || entry.Codec.Length == 0)
+            throw Invalid(path, $"{location}entry has an empty bank/name/file/codec");
+        if (ContainsWhitespace(entry.Bank) || ContainsWhitespace(entry.Name)
+            || ContainsWhitespace(entry.File) || ContainsWhitespace(entry.Codec))
+            throw Invalid(path,
+                $"{at} has a value with whitespace (the line format is space-separated)");
+        if (entry.Rate <= 0)
+            throw Invalid(path, $"{at} has rate {entry.Rate}");
+        if (entry.Channels is not (1 or 2))
+            throw Invalid(path, $"{at} has {entry.Channels} channels (the runtime is stereo)");
+        if (entry.Frames < 0)
+            throw Invalid(path, $"{at} has {entry.Frames} frames");
+        if (!double.IsFinite(entry.Seconds) || entry.Seconds < 0)
+            throw Invalid(path, $"{at} has seconds {entry.Seconds}");
+        if (!double.IsFinite(entry.GainDb) || entry.GainDb > 0)
+            throw Invalid(path, $"{at} has gain {entry.GainDb} dB (normalization only attenuates)");
+    }
+
+    private static bool ContainsWhitespace(string value) =>
+        value.Any(char.IsWhiteSpace);
+
+    private static int ParseInt(string path, int line, string key, string value)
+    {
+        if (!int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed))
+            throw Invalid(path, $"line {line + 1}: {key}=\"{value}\" is not an integer");
+        return parsed;
+    }
+
+    private static long ParseLong(string path, int line, string key, string value)
+    {
+        if (!long.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed))
+            throw Invalid(path, $"line {line + 1}: {key}=\"{value}\" is not an integer");
+        return parsed;
+    }
+
+    private static double ParseDouble(string path, int line, string key, string value)
+    {
+        if (!double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed)
+            || !double.IsFinite(parsed))
+            throw Invalid(path, $"line {line + 1}: {key}=\"{value}\" is not a finite number");
+        return parsed;
+    }
+
+    private static bool ParseLoop(string path, int line, string value) => value switch
+    {
+        "0" => false,
+        "1" => true,
+        _ => throw Invalid(path, $"line {line + 1}: loop=\"{value}\" is not 0/1"),
+    };
+
+    private static InvalidDataException Invalid(string path, string detail) => new($"{path}: {detail}");
+}
diff --git a/src/BpConvert.Core/Audio/SxdContainer.cs b/src/BpConvert.Core/Audio/SxdContainer.cs
new file mode 100644
index 0000000..0ddd59c
--- /dev/null
+++ b/src/BpConvert.Core/Audio/SxdContainer.cs
@@ -0,0 +1,184 @@
+using System.Buffers.Binary;
+using System.Text;
+
+namespace BpConvert.Core.Audio;
+
+/// <summary>
+/// One chunk of the SXDF chunk chain: a four-character tag followed by a little-endian u32 body
+/// size. The next chunk starts at <see cref="Offset"/> + 8 + <see cref="Size"/>.
+/// </summary>
+/// <param name="Magic">The chunk tag, e.g. <c>TONE</c>, <c>REQD</c>, <c>NAME</c>, <c>WAVE</c>, <c>DATA</c>.</param>
+/// <param name="Offset">File offset of the chunk header (the tag byte).</param>
+/// <param name="Size">Body size in bytes, i.e. everything after the 8-byte chunk header.</param>
+public sealed record SxdChunk(string Magic, long Offset, int Size);
+
+/// <summary>
+/// One parsed container: an <c>SXDF</c> bank/index (<c>.sxd</c>, <c>.sxd1</c>) or an <c>SXDS</c>
+/// stream payload (<c>.sxd2</c>). Both share the same 0x60-byte header (recon §1).
+/// </summary>
+/// <param name="Path">The file the bank was read from; <see cref="SxdTables"/> re-reads it.</param>
+/// <param name="Version">The u16 at 0x04; 4 on every shipped container.</param>
+/// <param name="HashHex">The 16-byte bank GUID at 0x10 as lowercase hex; identical inside a pair.</param>
+/// <param name="Name">The NUL-padded bank name at 0x20.</param>
+/// <param name="Chunks">
+/// The chunk chain from 0x60, in file order. Empty for an <c>SXDS</c>: its body is raw payload,
+/// not a chunk chain (the +0x08 field is a stream count there).
+/// </param>
+/// <param name="DataOffset">
+/// The <c>DATA</c> chunk header offset on an <c>SXDF</c> (the payload starts at
+/// <c>DataOffset + 0x10</c>: 8 header + 8 zero bytes, recon §7.1), or 0x60 on an
+/// <c>SXDS</c>, where the body itself is the payload. Zero when <paramref name="HasData"/> is
+/// false (no <c>DATA</c> chunk).
+/// </param>
+/// <param name="DataSize">
+/// The <c>DATA</c> chunk body size on an <c>SXDF</c>, or the <c>SXDS</c> payload size from +0x0C.
+/// </param>
+/// <param name="HasData">True when the file carries wave payload bytes (a <c>DATA</c> chunk or an <c>SXDS</c> body).</param>
+/// <param name="CompanionSize">
+/// The u32 at 0x0C: the companion <c>.sxd2</c> file size on an <c>SXDF</c> index (0 when the bank
+/// is self-contained), or the payload size on an <c>SXDS</c>.
+/// </param>
+public sealed record SxdBank(
+    string Path, ushort Version, string HashHex, string Name, IReadOnlyList<SxdChunk> Chunks,
+    long DataOffset, int DataSize, bool HasData, uint CompanionSize);
+
+/// <summary>
+/// Reader for the <c>SXDF</c>/<c>SXDS</c> container (recon §1; the C# counterpart of the
+/// <c>s5_decode_gate.py</c> header/chunk walk): the 0x60-byte header, the chunk chain from 0x60,
+/// and the <c>DATA</c> region the resident tables address. Malformed files throw
+/// <see cref="InvalidDataException"/> whose message starts with the input path.
+/// </summary>
+/// <remarks>
+/// The chunk walk must land exactly on EOF: on every shipped container the last chunk ends at the
+/// file size, and the <c>+0x08</c> own-size field equals it. A truncated or padded chain therefore
+/// fails here rather than in a table reader.
+/// </remarks>
+public static class SxdContainer
+{
+    /// <summary>Header length shared by both magics; the first chunk starts here.</summary>
+    public const int HeaderLength = 0x60;
+
+    private const int ChunkHeaderLength = 8;
+    private const int VersionOffset = 0x04;
+    private const int SizeOrStreamsOffset = 0x08;
+    private const int CompanionSizeOffset = 0x0C;
+    private const int HashOffset = 0x10;
+    private const int HashLength = 16;
+    private const int NameOffset = 0x20;
+    private const int NameLength = 32;
+
+    // The gate's tag rule: every byte of a four-character tag is in its 0x30..0x5A range (which
+    // also admits the punctuation between '9' and 'A'; the shipped tags are all letters).
+    private const byte TagMin = 0x30;
+    private const byte TagMax = 0x5A;
+
+    /// <summary>Reads one <c>SXDF</c> bank/index or <c>SXDS</c> stream payload.</summary>
+    /// <param name="path">Path to the <c>.sxd</c>/<c>.sxd1</c>/<c>.sxd2</c> file.</param>
+    /// <exception cref="InvalidDataException">
+    /// The file is shorter than the 0x60-byte header, its magic is neither <c>SXDF</c> nor
+    /// <c>SXDS</c>, the declared size disagrees with the file, or a chunk header/body is
+    /// truncated or duplicated.
+    /// </exception>
+    public static SxdBank Read(string path)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(path);
+
+        var data = File.ReadAllBytes(path);
+        if (data.Length < HeaderLength)
+            throw Invalid(path, $"shorter than the 0x{HeaderLength:X} header ({data.Length} B)");
+
+        var magic = Encoding.ASCII.GetString(data, 0, 4);
+        if (magic is not ("SXDF" or "SXDS"))
+            throw Invalid(path, $"magic \"{Escaped(magic)}\" is not SXDF/SXDS");
+
+        var version = BinaryPrimitives.ReadUInt16LittleEndian(data.AsSpan(VersionOffset));
+        var sizeOrStreams = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(SizeOrStreamsOffset));
+        var companionSize = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(CompanionSizeOffset));
+
+        IReadOnlyList<SxdChunk> chunks = magic == "SXDF"
+            ? WalkChunks(path, data, sizeOrStreams)
+            : Array.Empty<SxdChunk>();
+
+        long dataOffset;
+        int dataSize;
+        bool hasData;
+        if (magic == "SXDF")
+        {
+            var dataChunk = chunks.FirstOrDefault(chunk => chunk.Magic == "DATA");
+            dataOffset = dataChunk?.Offset ?? 0;
+            dataSize = dataChunk?.Size ?? 0;
+            hasData = dataChunk is not null;
+        }
+        else
+        {
+            // An SXDS has no chunk chain: +0x08 is a stream count and +0x0C the payload size,
+            // with the payload starting at the end of the header and running to EOF.
+            if (HeaderLength + (long)companionSize != data.Length)
+                throw Invalid(path,
+                    $"payload size @0x0C = {companionSize} does not match the file ({data.Length - HeaderLength} B after the header)");
+            dataOffset = HeaderLength;
+            dataSize = (int)companionSize;
+            hasData = true;
+        }
+
+        return new SxdBank(
+            path, version, Convert.ToHexStringLower(data.AsSpan(HashOffset, HashLength)),
+            ReadName(path, data), chunks, dataOffset, dataSize, hasData, companionSize);
+    }
+
+    /// <summary>
+    /// Walks <c>0x60 .. EOF</c>: <c>char[4] magic + u32 body size</c>, next at
+    /// <c>offset + size + 8</c>. The walk must consume the file exactly.
+    /// </summary>
+    private static List<SxdChunk> WalkChunks(string path, byte[] data, uint declaredSize)
+    {
+        if (declaredSize != data.Length)
+            throw Invalid(path, $"size field @0x08 = {declaredSize} != file size {data.Length}");
+
+        var chunks = new List<SxdChunk>();
+        var seen = new HashSet<string>(StringComparer.Ordinal);
+        long offset = HeaderLength;
+        while (offset < data.Length)
+        {
+            if (offset + ChunkHeaderLength > data.Length)
+                throw Invalid(path, $"chunk header at 0x{offset:X} is truncated");
+            var chunkMagic = ReadTag(path, data, offset);
+            if (!seen.Add(chunkMagic))
+                throw Invalid(path, $"duplicate {chunkMagic} chunk at 0x{offset:X}");
+
+            var size = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan((int)offset + 4));
+            if (size > int.MaxValue || offset + ChunkHeaderLength + size > data.Length)
+                throw Invalid(path,
+                    $"{chunkMagic} chunk at 0x{offset:X} overruns the file ({size} B body, {data.Length - offset - ChunkHeaderLength} B left)");
+
+            chunks.Add(new SxdChunk(chunkMagic, offset, (int)size));
+            offset += ChunkHeaderLength + size;
+        }
+
+        if (chunks.Count == 0)
+            throw Invalid(path, "no chunks at 0x60");
+        return chunks;
+    }
+
+    private static string ReadTag(string path, byte[] data, long offset)
+    {
+        var tag = data.AsSpan((int)offset, 4);
+        foreach (var b in tag)
+            if (b is < TagMin or > TagMax)
+                throw Invalid(path, $"chunk tag at 0x{offset:X} is outside 0x30..0x5A");
+        return Encoding.ASCII.GetString(tag);
+    }
+
+    private static string ReadName(string path, byte[] data)
+    {
+        var field = data.AsSpan(NameOffset, NameLength);
+        var nul = field.IndexOf((byte)0);
+        var name = Encoding.Latin1.GetString(nul < 0 ? field : field[..nul]);
+        return name.Length > 0 ? name : throw Invalid(path, "empty bank name at 0x20");
+    }
+
+    private static string Escaped(string magic) =>
+        string.Concat(magic.Select(c => c is >= ' ' and <= '~' ? c.ToString() : $"\\x{(int)c:X2}"));
+
+    private static InvalidDataException Invalid(string path, string detail) => new($"{path}: {detail}");
+}
diff --git a/src/BpConvert.Core/Audio/SxdTables.cs b/src/BpConvert.Core/Audio/SxdTables.cs
new file mode 100644
index 0000000..8b2e730
--- /dev/null
+++ b/src/BpConvert.Core/Audio/SxdTables.cs
@@ -0,0 +1,373 @@
+using System.Buffers.Binary;
+using System.Text;
+
+namespace BpConvert.Core.Audio;
+
+/// <summary>
+/// One <c>WAVE</c> table record. The field slots are the same for music and resident banks
+/// (recon §2/§7): <c>+0x04</c> format word, <c>+0x08</c> sample rate, <c>+0x14</c> per-channel
+/// frame count, <c>+0x20</c> byte length, <c>+0x24</c> start.
+/// </summary>
+/// <param name="Index">Record index in the table.</param>
+/// <param name="RecordOffset">File offset of the record itself (needed by the resident payload formula).</param>
+/// <param name="RecordSize">
+/// Bytes from this record to the next one (or to the end of the <c>WAVE</c> chunk). The stride is
+/// variable per bank: 48/56/68/76 on <c>boss01</c> (com_obj 80/264, com_v 80, com_b_h 160) and
+/// 76 on every music record.
+/// </param>
+/// <param name="FormatWord">The <c>+0x04</c> word; byte 1 is the channel count, the low byte the codec id.</param>
+/// <param name="SampleRate">The <c>+0x08</c> rate (48 000 on every shipped record).</param>
+/// <param name="Frames">The <c>+0x14</c> per-channel sample count.</param>
+/// <param name="Start">
+/// The <c>+0x24</c> value. It is <b>absolute in the companion <c>.sxd2</c></b> for a music bank
+/// (no <c>DATA</c> chunk), and <b>relative to this record</b> for a resident bank, where the
+/// payload is at <see cref="RecordOffset"/> + 0x24 + <see cref="Start"/> for
+/// <see cref="ByteLength"/> bytes (the loader formula, <c>FUN_00983220</c>, recon §7.1).
+/// </param>
+/// <param name="ByteLength">The <c>+0x20</c> payload length in bytes.</param>
+/// <param name="CodecConfig">
+/// The ATRAC9 config word for the <c>0x42</c> codec family, or 0 for PS-ADPCM (<c>0x21</c>).
+/// Music/76-byte records carry it at <c>+0x40</c> (<c>0xFE761DF0</c> on all 33 tracks); resident
+/// <c>0x42</c> records carry it at <c>+0x2C</c> on the 56-byte form and <c>+0x40</c> on the
+/// 76-byte form (recon §5.0/§7.3). The AT9 decoder re-emits it big-endian as extradata.
+/// </param>
+public sealed record WaveRecord(
+    int Index, long RecordOffset, int RecordSize, uint FormatWord, uint SampleRate, uint Frames,
+    long Start, int ByteLength, uint CodecConfig);
+
+/// <summary>
+/// One <c>NAME</c> table entry: the request name in table (and string-pool) order.
+/// </summary>
+/// <param name="Index">
+/// The NAME entry index (0-based). This is <b>not</b> the <c>REQD</c> key and <b>not</b> a
+/// <c>WAVE</c> index: entry 0 of <c>boss01</c> is <c>boss01_atk_hit_ground1</c> (REQD 303,
+/// wave 26). Use <see cref="ReqdId"/> for the request chain.
+/// </param>
+/// <param name="Name">The NUL-terminated request name, decoded one byte per char (Latin-1).</param>
+/// <param name="ReqdId">
+/// The third u32 of the 12-byte entry: the <c>REQD</c> table key the engine looks up by name hash
+/// (<c>FUN_00987a80</c>). The pool fallback keeps the entry order, so the id stays paired with
+/// <paramref name="Name"/> on the shipped banks.
+/// </param>
+public sealed record NameRecord(int Index, string Name, uint ReqdId);
+
+/// <summary>
+/// Reader for the <c>WAVE</c> and <c>NAME</c> index tables (recon §1-§3; the C# counterpart of
+/// <c>s5_decode_gate.py</c>'s <c>table_records</c>/<c>read_wave_record</c> and
+/// <c>s5_audition.py</c>'s <c>bank_names</c>).
+/// </summary>
+/// <remarks>
+/// <para>
+/// <c>REQD</c>, <c>NAME</c> (offsets only — see below), <c>WAVE</c> and <c>SEQD</c> share the
+/// generic table shape <c>{+0x04 size, +0x08 reserved, +0x0C count, +0x10 offsets[count]}</c>
+/// with <c>record_i = chunk + 0x10 + offsets[i] + 4*i</c>. The <c>+ 4*i</c> term is the format,
+/// not slack: <c>offsets[]</c> advance by <c>stride - 4</c>, so the same rule addresses a
+/// variable-stride table. No stride is assumed anywhere in this reader.
+/// </para>
+/// <para>
+/// <c>NAME</c> is a 12-byte entry table <c>{u32 string_offset, u32 hash, u32 reqd_id}</c>, where
+/// <c>string_offset</c> is relative to the entry itself (<c>name = entry + string_offset</c>); the
+/// entries are followed by the NUL-terminated string pool they point into. The engine's hash is
+/// <c>u = byte + u*0x83</c> (<c>FUN_00987a80</c>). When every entry resolves and every ASCII name
+/// matches that hash the table wins; otherwise (e.g. a different stride in an unreleased bank)
+/// the pool is read in order and paired with the entries by index, which is the same order on
+/// every shipped bank.
+/// </para>
+/// </remarks>
+public static class SxdTables
+{
+    private const int TableCountOffset = 0x0C;
+    private const int TableBodyOffset = 0x10;
+    private const int WavePrefixLength = 0x28;
+    private const int WaveFormatOffset = 0x04;
+    private const int WaveRateOffset = 0x08;
+    private const int WaveFramesOffset = 0x14;
+    private const int WaveByteLengthOffset = 0x20;
+    private const int WaveStartOffset = 0x24;
+    private const int WaveAt9ConfigOffsetShort = 0x2C;
+    private const int WaveAt9ConfigOffsetLong = 0x40;
+    private const int NameEntryLength = 12;
+    private const int NameReqdIdOffset = 8;
+    private const int TrackNameOffset = 0x20;
+    private const int TrackNameLength = 0x40;
+    private const uint NameHashMultiplier = 0x83;
+
+    /// <summary>Reads the <c>WAVE</c> table in table order.</summary>
+    /// <param name="bank">A bank from <see cref="SxdContainer.Read"/>; <see cref="SxdBank.Path"/> is re-read.</param>
+    /// <returns>All records, or an empty list when the bank has no <c>WAVE</c> chunk.</returns>
+    /// <exception cref="InvalidDataException">
+    /// The table header, an <c>offsets[]</c> entry or a record prefix is out of bounds, or the
+    /// records are not strictly increasing (an overlap).
+    /// </exception>
+    public static IReadOnlyList<WaveRecord> Waves(SxdBank bank)
+    {
+        ArgumentNullException.ThrowIfNull(bank);
+
+        var chunk = FindChunk(bank, "WAVE");
+        if (chunk is null)
+            return Array.Empty<WaveRecord>();
+
+        var path = bank.Path;
+        var data = File.ReadAllBytes(path);
+        var count = ReadCount(path, data, chunk);
+        var body = chunk.Offset + TableBodyOffset;
+        var chunkEnd = chunk.Offset + ChunkLength(chunk);
+        if (body + 4L * count > chunkEnd)
+            throw Invalid(path, $"WAVE count {count} overruns the chunk");
+
+        var offsets = new long[count];
+        for (var i = 0; i < count; i++)
+        {
+            var relative = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan((int)(body + 4L * i)));
+            var record = body + relative + 4L * i;
+            if (record + WavePrefixLength > chunkEnd)
+                throw Invalid(path, $"WAVE record {i} at 0x{record:X} escapes the chunk");
+            if (i > 0 && record <= offsets[i - 1])
+                throw Invalid(path, $"WAVE record {i} at 0x{record:X} overlaps record {i - 1} at 0x{offsets[i - 1]:X}");
+            offsets[i] = record;
+        }
+
+        var waves = new List<WaveRecord>((int)count);
+        for (var i = 0; i < count; i++)
+        {
+            var record = offsets[i];
+            var size = (int)((i + 1 < count ? offsets[i + 1] : chunkEnd) - record);
+            var formatWord = ReadU32(path, data, record + WaveFormatOffset);
+            var byteLength = ReadU32(path, data, record + WaveByteLengthOffset);
+            if (byteLength > int.MaxValue)
+                throw Invalid(path, $"WAVE record {i} byte length {byteLength} exceeds int.MaxValue");
+            waves.Add(new WaveRecord(
+                i, record, size,
+                formatWord,
+                ReadU32(path, data, record + WaveRateOffset),
+                ReadU32(path, data, record + WaveFramesOffset),
+                ReadU32(path, data, record + WaveStartOffset),
+                (int)byteLength,
+                ReadCodecConfig(path, data, record, size, formatWord, chunkEnd)));
+        }
+
+        return waves;
+    }
+
+    /// <summary>
+    /// Reads the ATRAC9 config word of a <c>0x42</c> record: <c>+0x2C</c> on the 56-byte
+    /// (and shorter) resident form, <c>+0x40</c> on the 76-byte music/resident form; 0 for
+    /// every other codec and for a record too short to carry the field.
+    /// </summary>
+    /// <remarks>
+    /// The position is the record's own layout, not a scan: the gate's "first <c>0xFE</c> dword
+    /// at/after <c>+0x28</c>" search lands on exactly these offsets on every shipped record
+    /// (recon §5.0/§7.3) and a scan would also accept an accidental byte pattern.
+    /// </remarks>
+    private static uint ReadCodecConfig(
+        string path, byte[] data, long record, int recordSize, uint formatWord, long chunkEnd)
+    {
+        if ((formatWord & 0xFF) != 0x42)
+            return 0;
+
+        var offset = recordSize >= 0x44 ? WaveAt9ConfigOffsetLong : WaveAt9ConfigOffsetShort;
+        if (offset + 4 > recordSize || record + offset + 4 > chunkEnd)
+            return 0; // Decode rejects a 0x42 payload without a config word.
+        return ReadU32(path, data, record + offset);
+    }
+
+    /// <summary>
+    /// Reads the <c>0x40</c>-byte track-name slot at <c>+0x20</c> of every <c>REQD</c> record, in
+    /// table order. Music index banks name their 33 tracks there ("Prologue", "Boss 1", …; recon
+    /// §2/§6); resident banks use the <c>NAME</c> table instead and usually leave these slots
+    /// empty.
+    /// </summary>
+    /// <param name="bank">A bank from <see cref="SxdContainer.Read"/>; <see cref="SxdBank.Path"/> is re-read.</param>
+    /// <returns>The slots in table order, or an empty list when the bank has no <c>REQD</c> chunk.</returns>
+    /// <exception cref="InvalidDataException">The table or a name slot is out of bounds.</exception>
+    public static IReadOnlyList<string> TrackNames(SxdBank bank)
+    {
+        ArgumentNullException.ThrowIfNull(bank);
+
+        var chunk = FindChunk(bank, "REQD");
+        if (chunk is null)
+            return Array.Empty<string>();
+
+        var path = bank.Path;
+        var data = File.ReadAllBytes(path);
+        var count = ReadCount(path, data, chunk);
+        var body = chunk.Offset + TableBodyOffset;
+        var chunkEnd = chunk.Offset + ChunkLength(chunk);
+        if (body + 4L * count > chunkEnd)
+            throw Invalid(path, $"REQD count {count} overruns the chunk");
+
+        var names = new List<string>((int)count);
+        for (var i = 0L; i < count; i++)
+        {
+            var relative = BinaryPrimitives.ReadUInt32LittleEndian(
+                data.AsSpan((int)(body + 4L * i)));
+            var record = body + relative + 4L * i;
+            // The 0x40-byte slot is not inside the chunk on every record (music record 31
+            // reaches 8 bytes into the following NAME header), so bound it by the file, exactly
+            // like the gate's `buf[rec+0x20:rec+0x60].split(b"\0")[0]`.
+            var start = record + TrackNameOffset;
+            if (start >= data.Length)
+                throw Invalid(path, $"REQD record {i} name slot is beyond EOF");
+            var length = (int)Math.Min(TrackNameLength, data.Length - start);
+            var slot = data.AsSpan((int)start, length);
+            var nul = slot.IndexOf((byte)0);
+            names.Add(Encoding.Latin1.GetString(nul < 0 ? slot : slot[..nul]));
+        }
+
+        return names;
+    }
+
+    /// <summary>Reads the <c>NAME</c> table (request-name namespace) in table order.</summary>
+    /// <param name="bank">A bank from <see cref="SxdContainer.Read"/>; <see cref="SxdBank.Path"/> is re-read.</param>
+    /// <returns>All entries, or an empty list when the bank has no <c>NAME</c> chunk.</returns>
+    /// <exception cref="InvalidDataException">
+    /// The entry array is out of bounds, neither the 12-byte entries nor the string pool resolve,
+    /// or a name is empty, contains a C0/DEL byte, or is duplicated inside the bank.
+    /// </exception>
+    public static IReadOnlyList<NameRecord> Names(SxdBank bank)
+    {
+        ArgumentNullException.ThrowIfNull(bank);
+
+        var chunk = FindChunk(bank, "NAME");
+        if (chunk is null)
+            return Array.Empty<NameRecord>();
+
+        var path = bank.Path;
+        var data = File.ReadAllBytes(path);
+        var count = ReadCount(path, data, chunk);
+        var body = chunk.Offset + TableBodyOffset;
+        var chunkEnd = chunk.Offset + ChunkLength(chunk);
+        if (body + NameEntryLength * (long)count > chunkEnd)
+            throw Invalid(path, $"NAME count {count} overruns the chunk");
+
+        // The third word of each 12-byte entry is the REQD key; it is read from the entry array on
+        // both paths because the pool keeps the entry order.
+        var reqdIds = new uint[count];
+        for (var i = 0L; i < count; i++)
+            reqdIds[i] = ReadU32(path, data, body + NameEntryLength * i + NameReqdIdOffset);
+
+        var names = TryReadEntryTable(data, body, count, chunkEnd);
+        if (names is null)
+        {
+            var pool = ReadPool(data, body + NameEntryLength * (long)count, chunkEnd);
+            if (pool.Count < count)
+                throw Invalid(path, $"NAME string pool holds {pool.Count} names, expected {count}");
+            names = pool.GetRange(0, (int)count);
+        }
+
+        var records = new List<NameRecord>(names.Count);
+        var seen = new HashSet<string>(StringComparer.Ordinal);
+        for (var i = 0; i < names.Count; i++)
+        {
+            if (names[i].Length == 0)
+                throw Invalid(path, $"NAME entry {i} is empty");
+            // C0 controls and DEL are impossible in a request name; C1 bytes (0x80..0x9F) pass on
+            // purpose because they are the Shift-JIS lead bytes of the Japanese placeholders.
+            foreach (var c in names[i])
+                if (c is < ' ' or '\x7F')
+                    throw Invalid(path, $"NAME entry {i} contains a C0/DEL byte");
+            if (!seen.Add(names[i]))
+                throw Invalid(path, $"NAME entry {i} duplicates \"{names[i]}\"");
+            records.Add(new NameRecord(i, names[i], reqdIds[i]));
+        }
+
+        return records;
+    }
+
+    /// <summary>
+    /// Resolves the 12-byte NAME entries (<c>name = entry + string_offset</c>) and verifies the
+    /// engine hash on every ASCII name. Returns null when the layout does not resolve, which sends
+    /// the caller to the string pool.
+    /// </summary>
+    private static List<string>? TryReadEntryTable(byte[] data, long body, uint count, long chunkEnd)
+    {
+        var names = new List<string>((int)count);
+        for (var i = 0L; i < count; i++)
+        {
+            var entry = body + NameEntryLength * i;
+            var stringOffset = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan((int)entry));
+            var hash = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan((int)entry + 4));
+            var start = entry + stringOffset;
+            if (start < body || start >= chunkEnd)
+                return null;
+
+            var end = start;
+            while (end < chunkEnd && data[end] != 0)
+                end++;
+            if (end == start || end >= chunkEnd)
+                return null;
+
+            var bytes = data.AsSpan((int)start, (int)(end - start));
+            if (IsAscii(bytes) && EngineHash(bytes) != hash)
+                return null;
+            names.Add(Encoding.Latin1.GetString(bytes));
+        }
+
+        return names;
+    }
+
+    /// <summary>The NUL-terminated string pool after the NAME entries, empty strings dropped.</summary>
+    private static List<string> ReadPool(byte[] data, long start, long end)
+    {
+        var names = new List<string>();
+        var position = start;
+        while (position < end)
+        {
+            var nul = position;
+            while (nul < end && data[nul] != 0)
+                nul++;
+            if (nul >= end)
+                break;
+            if (nul > position)
+                names.Add(Encoding.Latin1.GetString(data, (int)position, (int)(nul - position)));
+            position = nul + 1;
+        }
+
+        return names;
+    }
+
+    /// <summary>True when every byte is ASCII (the hash is only verified for those names).</summary>
+    private static bool IsAscii(ReadOnlySpan<byte> bytes)
+    {
+        foreach (var b in bytes)
+            if (b >= 0x80)
+                return false;
+        return true;
+    }
+
+    /// <summary>The engine's name hash (<c>FUN_00987a80</c>): <c>u = byte + u * 0x83</c>, u32 wrap.</summary>
+    private static uint EngineHash(ReadOnlySpan<byte> bytes)
+    {
+        var hash = 0u;
+        foreach (var b in bytes)
+            hash = unchecked(b + hash * NameHashMultiplier);
+        return hash;
+    }
+
+    private static SxdChunk? FindChunk(SxdBank bank, string magic)
+    {
+        foreach (var chunk in bank.Chunks)
+            if (chunk.Magic == magic)
+                return chunk;
+        return null;
+    }
+
+    /// <summary>A chunk's total length: 8-byte header plus body.</summary>
+    private static int ChunkLength(SxdChunk chunk) => 8 + chunk.Size;
+
+    private static uint ReadCount(string path, byte[] data, SxdChunk chunk)
+    {
+        if (chunk.Size < TableBodyOffset)
+            throw Invalid(path, $"{chunk.Magic} chunk at 0x{chunk.Offset:X} is too small for a table header");
+        return BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan((int)(chunk.Offset + TableCountOffset)));
+    }
+
+    private static uint ReadU32(string path, byte[] data, long offset)
+    {
+        if (offset + 4 > data.Length)
+            throw Invalid(path, $"field at 0x{offset:X} is beyond EOF");
+        return BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan((int)offset));
+    }
+
+    private static InvalidDataException Invalid(string path, string detail) => new($"{path}: {detail}");
+}
diff --git a/src/BpConvert.Core/Audio/WavWriter.cs b/src/BpConvert.Core/Audio/WavWriter.cs
new file mode 100644
index 0000000..af97a62
--- /dev/null
+++ b/src/BpConvert.Core/Audio/WavWriter.cs
@@ -0,0 +1,74 @@
+using System.Text;
+
+namespace BpConvert.Core.Audio;
+
+/// <summary>
+/// Writes the converter's deliverable WAV: float32 RIFF/WAVE (<c>fmt</c> tag 3), 48 kHz,
+/// mono or stereo. The format is pinned in <c>AudioTests.Wav_RoundTrips_Float32</c> and read by
+/// the viewer's <c>wav_io</c>; PCM16 would clamp the normalized mixes a second time, which is why
+/// the converter keeps IEEE float end-to-end.
+/// </summary>
+public static class WavWriter
+{
+    private const int HeaderLength = 44;
+    private const int FmtChunkLength = 16;
+    private const int FloatBytes = 4;
+    private const ushort IeeeFloat = 3;
+
+    /// <summary>
+    /// Writes <paramref name="samples"/> (interleaved) to <paramref name="path"/>, creating the
+    /// parent directory if needed.
+    /// </summary>
+    /// <param name="path">Destination <c>.wav</c>.</param>
+    /// <param name="samples">Interleaved float samples; length must be a multiple of <paramref name="channels"/>.</param>
+    /// <param name="channels">1 (mono) or 2 (stereo).</param>
+    /// <param name="rate">Sample rate in Hz; the converter always writes 48 000.</param>
+    /// <exception cref="ArgumentException">
+    /// An empty path, no samples, a length that is not whole frames, or a rate that does not
+    /// fit the RIFF fields.
+    /// </exception>
+    /// <exception cref="ArgumentOutOfRangeException"><paramref name="channels"/> is not 1 or 2.</exception>
+    public static void Write(string path, ReadOnlySpan<float> samples, int channels, int rate)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(path);
+        if (channels is not (1 or 2))
+            throw new ArgumentOutOfRangeException(
+                nameof(channels), channels, "the converter writes mono or stereo only");
+        if (rate <= 0)
+            throw new ArgumentOutOfRangeException(nameof(rate), rate, "rate must be positive");
+        if (samples.Length == 0)
+            throw new ArgumentException("no samples to write", nameof(samples));
+        if (samples.Length % channels != 0)
+            throw new ArgumentException(
+                $"{samples.Length} samples do not form whole {channels}-channel frames", nameof(samples));
+
+        var dataLength = checked(samples.Length * FloatBytes);
+        var riffLength = HeaderLength - 8L + dataLength;
+        if (riffLength > uint.MaxValue)
+            throw new ArgumentException($"data is too long for a RIFF file ({dataLength} B)", nameof(samples));
+
+        var directory = Path.GetDirectoryName(Path.GetFullPath(path));
+        if (!string.IsNullOrEmpty(directory))
+            Directory.CreateDirectory(directory);
+
+        using var stream = new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.None);
+        using var writer = new BinaryWriter(stream, Encoding.ASCII, leaveOpen: false);
+
+        writer.Write("RIFF"u8);
+        writer.Write((uint)riffLength);
+        writer.Write("WAVE"u8);
+        writer.Write("fmt "u8);
+        writer.Write((uint)FmtChunkLength);
+        writer.Write(IeeeFloat);
+        writer.Write((ushort)channels);
+        writer.Write((uint)rate);
+        writer.Write((uint)(rate * channels * FloatBytes)); // byte rate
+        writer.Write((ushort)(channels * FloatBytes)); // block align
+        writer.Write((ushort)(FloatBytes * 8)); // bits per sample
+        writer.Write("data"u8);
+        writer.Write((uint)dataLength);
+
+        foreach (var sample in samples)
+            writer.Write(sample);
+    }
+}
diff --git a/tests/BpConvert.Tests/AudioTests.cs b/tests/BpConvert.Tests/AudioTests.cs
new file mode 100644
index 0000000..faaa13f
--- /dev/null
+++ b/tests/BpConvert.Tests/AudioTests.cs
@@ -0,0 +1,690 @@
+using System.Buffers.Binary;
+using System.Text;
+using BpConvert.Core.Audio;
+
+/// <summary>
+/// Pinned cases for the SXDF container and its index tables (S5 Task 2;
+/// <c>tools/re/audio/s5_decode_gate.py</c> and <c>docs/notes/s5-audio-recon.md</c> are the
+/// parsing reference): the 0x60-byte header, the chunk chain from <c>0x60</c>, the shared
+/// <c>count/offsets[]</c> table (<c>record_i = body + offsets[i] + 4*i</c>, never a fixed
+/// stride), the absolute music starts, and the loader-derived resident payload formula
+/// <c>record + 0x24 + start</c> (recon §7.1). Task 3 adds the codec-config field, the WAV
+/// writer, the R1 manifest, and the decode/mix pipeline. Real-tree cases are env-gated
+/// through <see cref="TestAssets"/> (fail fast when <c>SOTC_GAME_ROOT</c> is unset — never
+/// skips); the AT9 cases need <c>ffmpeg</c> with its built-in <c>atrac9</c> decoder, exactly
+/// like the gate.
+/// </summary>
+public class AudioTests
+{
+    private static string Bank(string fileName) =>
+        TestAssets.Sample(Path.Combine("sound", "shadow", fileName));
+
+    [Fact]
+    public void Read_Boss01_HasTheChunkChainAndData()
+    {
+        var path = Bank("boss01.sxd");
+        var bank = SxdContainer.Read(path);
+
+        Assert.Equal("boss01", bank.Name);
+        Assert.Equal(4, bank.Version);
+        Assert.Equal("3817adac981f914ca9b4146794f91bb1", bank.HashHex);
+
+        // The chunk chain opens with TONE at 0x60 and every table the reader consumes is present.
+        Assert.Equal("TONE", bank.Chunks[0].Magic);
+        Assert.Equal(0x60, bank.Chunks[0].Offset);
+        foreach (var magic in new[] { "REQD", "NAME", "WAVE", "DATA" })
+            Assert.Contains(bank.Chunks, chunk => chunk.Magic == magic);
+
+        var data = Assert.Single(bank.Chunks, chunk => chunk.Magic == "DATA");
+        Assert.Equal(0x14f10, data.Offset);
+        Assert.True(bank.HasData);
+        Assert.Equal(data.Offset, bank.DataOffset);
+        Assert.Equal(data.Size, bank.DataSize);
+
+        // DATA is the last chunk and reaches EOF. `size` counts the body only, so the file end
+        // is offset + 8-byte chunk header + size (the gate's `DATA + 8 + size`, recon §3/§7).
+        Assert.Equal(new FileInfo(path).Length, bank.DataOffset + 8 + bank.DataSize);
+        var last = bank.Chunks[^1];
+        Assert.Equal(new FileInfo(path).Length, last.Offset + 8 + last.Size);
+    }
+
+    [Fact]
+    public void Read_MusicSxd1_HasNoData_AndMatchesItsSxd2Hash()
+    {
+        var index = SxdContainer.Read(Bank("music.sxd1"));
+        var payload = SxdContainer.Read(Bank("music.sxd2"));
+
+        Assert.DoesNotContain(index.Chunks, chunk => chunk.Magic == "DATA");
+        Assert.False(index.HasData);
+        Assert.Equal(0, index.DataSize);
+
+        // The GUID is identical inside the pair, so the index's hash is the payload's hash.
+        Assert.Equal(payload.HashHex, index.HashHex);
+        Assert.Equal(32, index.HashHex.Length);
+        Assert.Equal(new FileInfo(Bank("music.sxd2")).Length, index.CompanionSize);
+        Assert.Equal(0xa461d20L, index.CompanionSize);
+
+        // An SXDS is the stream body itself: no chunk chain, the payload starts at 0x60.
+        Assert.Empty(payload.Chunks);
+        Assert.Equal(0x60, payload.DataOffset);
+        Assert.Equal(new FileInfo(Bank("music.sxd2")).Length, payload.DataOffset + payload.DataSize);
+    }
+
+    [Fact]
+    public void Waves_ResidentFormula_TilesBoss01()
+    {
+        var bank = SxdContainer.Read(Bank("boss01.sxd"));
+        var waves = SxdTables.Waves(bank);
+
+        Assert.Equal(138, waves.Count);
+        // The table's offsets[] absorb the stride: the real records are 48/56/68/76 bytes.
+        Assert.Equal(new[] { 48, 56, 68, 76 },
+            waves.Select(wave => wave.RecordSize).Distinct().OrderBy(size => size).ToArray());
+        for (var i = 0; i < waves.Count; i++)
+        {
+            Assert.Equal(i, waves[i].Index);
+            Assert.InRange(waves[i].RecordSize, 0x28, 0x100);
+        }
+
+        // The fixed field slots: 48 kHz and the four codec/channel words of the bank.
+        Assert.All(waves, wave => Assert.Equal(48000u, wave.SampleRate));
+        Assert.Equal(new[] { 0x00FF0121u, 0x00FF0142u, 0x00FF0221u, 0x00FF0242u },
+            waves.Select(wave => wave.FormatWord).Distinct().OrderBy(word => word).ToArray());
+
+        // The loader formula (recon §7.1): payload = record + 0x24 + start, length = bytes.
+        var payloadStart = bank.DataOffset + 0x10;
+        var payloadEnd = bank.DataOffset + 8 + bank.DataSize;
+        Assert.Equal((payloadStart, payloadEnd), MergedUnion(waves
+            .Select(wave => (Offset: wave.RecordOffset + 0x24 + wave.Start, End: wave.RecordOffset + 0x24 + wave.Start + wave.ByteLength))));
+
+        // No duplicates on the union: the ranges cover the payload with zero gaps.
+        Assert.Equal(payloadEnd - payloadStart, waves
+            .Select(wave => (wave.RecordOffset + 0x24 + wave.Start, wave.ByteLength))
+            .Distinct()
+            .Sum(range => (long)range.ByteLength));
+    }
+
+    [Fact]
+    public void Waves_Music_StartsAreAbsolute()
+    {
+        var bank = SxdContainer.Read(Bank("music.sxd1"));
+        var waves = SxdTables.Waves(bank);
+
+        Assert.Equal(33, waves.Count);
+        Assert.All(waves, wave => Assert.Equal(76, wave.RecordSize));
+        Assert.All(waves, wave => Assert.Equal(48000u, wave.SampleRate));
+
+        // `start` is an absolute byte offset in music.sxd2, not relative to the payload base.
+        var ordered = waves.OrderBy(wave => wave.Start).ToList();
+        Assert.Equal(0x60, ordered[0].Start);
+        for (var i = 0; i + 1 < ordered.Count; i++)
+            Assert.Equal(ordered[i].Start + ordered[i].ByteLength, ordered[i + 1].Start);
+
+        // 960-byte ATRAC9 superframes (4 frames of 240 B / 256 samples), and the ranges tile
+        // the whole 0x60 .. companion-size payload.
+        Assert.All(waves, wave => Assert.Equal(0, wave.ByteLength % 960));
+        Assert.Equal(bank.CompanionSize, ordered[^1].Start + ordered[^1].ByteLength);
+    }
+
+    [Fact]
+    public void Waves_ComSys_PartitionTheDataPayload()
+    {
+        var bank = SxdContainer.Read(Bank("com_sys.sxd"));
+        var waves = SxdTables.Waves(bank);
+
+        Assert.Equal(16, waves.Count);
+        var payloadStart = bank.DataOffset + 0x10;
+        var payloadEnd = bank.DataOffset + 8 + bank.DataSize;
+        Assert.Equal(16, waves.Select(wave => wave.Start).Distinct().Count());
+        Assert.Equal((payloadStart, payloadEnd), MergedUnion(waves
+            .Select(wave => (Offset: wave.RecordOffset + 0x24 + wave.Start, End: wave.RecordOffset + 0x24 + wave.Start + wave.ByteLength))));
+
+        // com_sys has no duplicate ranges, so the declared lengths sum to the payload exactly.
+        Assert.Equal(bank.DataSize - 8, waves.Sum(wave => wave.ByteLength));
+    }
+
+    [Fact]
+    public void Waves_ComObj_PartitionTheDataPayload()
+    {
+        // The curated player bank (swing/hit cues), 241 records with 80/264-byte tail records:
+        // the same loader formula must tile it with zero gaps, duplicates and all.
+        var bank = SxdContainer.Read(Bank("com_obj.sxd"));
+        var waves = SxdTables.Waves(bank);
+
+        Assert.Equal(241, waves.Count);
+        var payloadStart = bank.DataOffset + 0x10;
+        var payloadEnd = bank.DataOffset + 8 + bank.DataSize;
+        Assert.Equal((payloadStart, payloadEnd), MergedUnion(waves
+            .Select(wave => (Offset: wave.RecordOffset + 0x24 + wave.Start, End: wave.RecordOffset + 0x24 + wave.Start + wave.ByteLength))));
+    }
+
+    [Fact]
+    public void Names_Boss01_AreReadableAndUnique()
+    {
+        var names = SxdTables.Names(SxdContainer.Read(Bank("boss01.sxd")));
+
+        Assert.Equal(343, names.Count);
+        for (var i = 0; i < names.Count; i++)
+        {
+            Assert.Equal(i, names[i].Index);
+            Assert.NotEmpty(names[i].Name);
+            Assert.All(names[i].Name, c => Assert.InRange(c, (char)0x20, (char)0x7E));
+        }
+
+        Assert.Equal(names.Count, names.Select(name => name.Name).Distinct(StringComparer.Ordinal).Count());
+        Assert.Contains("boss01", names[0].Name);
+        // Entry 0 is boss01_atk_hit_ground1; its third word is the REQD key (303), not the entry
+        // index and not a WAVE index (attribution: REQD 303 -> tone 43 -> wave 26).
+        Assert.Equal("boss01_atk_hit_ground1", names[0].Name);
+        Assert.Equal(0, names[0].Index);
+        Assert.Equal(303u, names[0].ReqdId);
+    }
+
+    [Fact]
+    public void Read_Truncated_Throws()
+    {
+        var source = Bank("boss01.sxd");
+        var path = Path.Combine(Path.GetTempPath(), $"bpconvert-sxd-{Guid.NewGuid():N}.sxd");
+        try
+        {
+            File.WriteAllBytes(path, File.ReadAllBytes(source)[..0x80]);
+
+            Assert.Throws<InvalidDataException>(() => SxdContainer.Read(path));
+        }
+        finally
+        {
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void Read_ChunkBodyOverrun_Throws()
+    {
+        // Patch the +0x08 own-size field to the truncated length so that guard passes: the chunk
+        // walk itself must catch the TONE body running past EOF.
+        var path = Path.Combine(Path.GetTempPath(), $"bpconvert-sxd-{Guid.NewGuid():N}.sxd");
+        try
+        {
+            var bytes = File.ReadAllBytes(Bank("boss01.sxd"))[..0x80];
+            BinaryPrimitives.WriteUInt32LittleEndian(bytes.AsSpan(0x08), (uint)bytes.Length);
+            File.WriteAllBytes(path, bytes);
+
+            var error = Assert.Throws<InvalidDataException>(() => SxdContainer.Read(path));
+            Assert.Contains("overruns the file", error.Message);
+        }
+        finally
+        {
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void Read_Bridge_AcceptsToneOnly()
+    {
+        var bank = SxdContainer.Read(Bank("bridge.sxd"));
+
+        var chunk = Assert.Single(bank.Chunks);
+        Assert.Equal("TONE", chunk.Magic);
+        Assert.Equal(0x60, chunk.Offset);
+        Assert.False(bank.HasData);
+        Assert.Equal(0, bank.DataOffset);
+        Assert.Equal(0, bank.DataSize);
+        Assert.Empty(SxdTables.Waves(bank)); // no WAVE table in this bank
+    }
+
+    [Fact]
+    public void Names_FallBackToThePool_WhenTheEntryStrideDoesNotResolve()
+    {
+        // A synthetic NAME table whose 12-byte entries carry a zero string offset: the entry
+        // layout cannot resolve (the "name" would start on its own offset word), so the reader
+        // must read the NUL-terminated pool after the entries and keep the entry order.
+        var path = Path.Combine(Path.GetTempPath(), $"bpconvert-name-{Guid.NewGuid():N}.sxd");
+        try
+        {
+            File.WriteAllBytes(path, BuildNameOnlyBank("alpha\0beta\0", new uint[] { 7, 9 }));
+
+            var names = SxdTables.Names(SxdContainer.Read(path));
+
+            Assert.Equal(2, names.Count);
+            Assert.Equal("alpha", names[0].Name);
+            Assert.Equal(7u, names[0].ReqdId);
+            Assert.Equal("beta", names[1].Name);
+            Assert.Equal(9u, names[1].ReqdId);
+        }
+        finally
+        {
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void Waves_CodecConfig_Pinned()
+    {
+        // Music records carry the AT9 config word verbatim at +0x40 (recon §2); resident 0x42
+        // records carry it at +0x2C (56-byte) or +0x40 (76-byte) (recon §5.0/§7.3); the 0x21
+        // PS-ADPCM family has no AT9 config and reads 0.
