+        Console.Error.WriteLine("bp-convert audio: --out <lib> is required");
+        PrintUsage();
+        return 2;
+    }
+    if (map is null)
+    {
+        Console.Error.WriteLine("bp-convert audio: --map <map.json> is required");
+        PrintUsage();
+        return 2;
+    }
+    if (!File.Exists(map))
