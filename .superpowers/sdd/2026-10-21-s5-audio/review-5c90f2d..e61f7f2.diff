+
+namespace {
+
+constexpr float kCategoryGains[] = {0.7f, 0.5f, 1.0f};  // music, ambience, sfx
+constexpr float kReferenceDistance = 8.0f;              // attenuation 1/(1 + d/8)
+constexpr float kPanSpread = 0.7f;
+constexpr int kBlockFrames = 800;                       // 1/60 s at 48 kHz
+constexpr int kLeadBlocks = 3;                          // ~50 ms of prebuffer
+constexpr int kTargetQueuedBytes = kLeadBlocks * kBlockFrames * 2 * 4;
+constexpr int kMaxQueuedBytes = 48000 * 2 * 4 / 2;      // half a second of output
+constexpr int kMaxTopUpBlocks = 8;                      // ~133 ms per call, bounded
+
+float category_gain(AudioCategory category) {
+    return kCategoryGains[static_cast<int>(category)];
+}
+
+float sanitize_gain(float gain) {
+    if (!std::isfinite(gain)) {
+        return 0.0f;
+    }
+    return std::clamp(gain, 0.0f, AudioEngine::kMaxVoiceGain);
+}
+
+// Whitespace-separated tokens; `#` starts a comment. `\r` counts as
+// whitespace, so CRLF manifests parse.
+std::vector<std::string> split_tokens(const std::string& line) {
+    std::vector<std::string> tokens;
+    std::string token;
+    for (const char character : line) {
+        if (character == '#') {
+            break;
+        }
+        if (std::isspace(static_cast<unsigned char>(character)) != 0) {
+            if (!token.empty()) {
+                tokens.push_back(std::move(token));
+                token.clear();
+            }
+        } else {
+            token.push_back(character);
+        }
+    }
+    if (!token.empty()) {
+        tokens.push_back(std::move(token));
+    }
+    return tokens;
+}
+
+}  // namespace
+
+AudioEngine::AudioEngine() {
+    voices_.resize(kMaxVoices);
+    mixBuffer_.resize(static_cast<std::size_t>(kMaxMixFrames) * 2);
+}
+
+AudioEngine::~AudioEngine() {
+    if (stream_ != nullptr) {
+        SDL_DestroyAudioStream(stream_);
+        stream_ = nullptr;
+    }
+    if (device_ != 0) {
+        SDL_CloseAudioDevice(device_);
+        device_ = 0;
+    }
+}
+
+bool AudioEngine::load_manifest(const std::string& manifestPath,
+                                const std::string& libraryRoot) {
+    last_error_.clear();
+
+    auto fail = [this](const std::string& message) {
+        last_error_ = message;
+        std::fprintf(stderr, "sotc-viewer: audio: %s\n", message.c_str());
+        return false;
+    };
+
+    std::error_code file_error;
+    if (!std::filesystem::is_regular_file(manifestPath, file_error)) {
+        // A missing manifest degrades to silence with one warning; the engine
+        // is left empty rather than keeping a stale clip set.
+        stop_all_voices();
+        clips_.clear();
+        warnedMissing_.clear();
+        return fail(manifestPath + ": cannot open audio manifest");
+    }
+    std::ifstream in(manifestPath);
+    if (!in) {
+        stop_all_voices();
+        clips_.clear();
+        warnedMissing_.clear();
+        return fail(manifestPath + ": cannot open audio manifest");
+    }
+
+    std::unordered_map<std::string, AudioClip> loaded;
+    std::string line;
+    int line_number = 0;
+    while (std::getline(in, line)) {
+        ++line_number;
+        const std::vector<std::string> tokens = split_tokens(line);
+        if (tokens.empty()) {
+            continue;
+        }
+
+        std::unordered_map<std::string, std::string> fields;
+        for (const std::string& token : tokens) {
+            const std::size_t equals = token.find('=');
+            if (equals == std::string::npos || equals == 0) {
+                return fail(manifestPath + ":" + std::to_string(line_number) +
+                            ": expected key=value, got '" + token + "'");
+            }
+            fields.emplace(token.substr(0, equals), token.substr(equals + 1));
+        }
+
+        const auto version = fields.find("version");
+        if (version != fields.end() && version->second != "1") {
+            return fail(manifestPath + ":" + std::to_string(line_number) +
+                        ": unsupported audio manifest version '" + version->second + "'");
+        }
+        if (version != fields.end() && fields.find("name") == fields.end()) {
+            continue;  // the format line
+        }
+
+        const auto name_it = fields.find("name");
+        if (name_it == fields.end() || name_it->second.empty()) {
+            return fail(manifestPath + ":" + std::to_string(line_number) +
+                        ": audio entry has no name=");
+        }
+        const std::string& name = name_it->second;
+        if (loaded.find(name) != loaded.end()) {
+            return fail(manifestPath + ":" + std::to_string(line_number) +
+                        ": duplicate audio name '" + name + "'");
+        }
+
+        const auto file_it = fields.find("file");
+        if (file_it == fields.end() || file_it->second.empty()) {
+            return fail(manifestPath + ":" + std::to_string(line_number) + ": audio '" + name +
+                        "' has no file=");
+        }
+        if (std::filesystem::path(file_it->second).is_absolute()) {
+            return fail(manifestPath + ":" + std::to_string(line_number) + ": audio '" + name +
+                        "' file= must be libraryRoot-relative, got '" + file_it->second +
+                        "'");
+        }
+        const std::filesystem::path wav_path =
+            std::filesystem::path(libraryRoot) / file_it->second;
+
+        AudioClip clip;
+        std::string wav_error;
+        if (!read_wav(wav_path, clip, &wav_error)) {
+            return fail(manifestPath + ":" + std::to_string(line_number) + ": audio '" + name +
+                        "': " + wav_error);
+        }
+        if (clip.frames() == 0) {
+            return fail(manifestPath + ":" + std::to_string(line_number) + ": audio '" + name +
+                        "': " + wav_path.string() + " carries no sample frames");
+        }
+        const auto loop = fields.find("loop");
+        if (loop != fields.end() && loop->second == "1") {
+            clip.loop = true;
+        }
+        loaded.emplace(name, std::move(clip));
+    }
+    if (in.bad()) {
+        return fail(manifestPath + ": read error");
+    }
+
+    // Commit: the previous clip set stays untouched on any failure above, so a
+    // voice never outlives the samples it points at.
+    stop_all_voices();
+    clips_ = std::move(loaded);
+    warnedMissing_.clear();
+    return true;
+}
+
+bool AudioEngine::has(const std::string& name) const {
+    return clips_.find(name) != clips_.end();
+}
+
+const AudioClip* AudioEngine::find_clip(const std::string& name) const {
+    const auto it = clips_.find(name);
+    return it == clips_.end() ? nullptr : &it->second;
+}
+
+void AudioEngine::start_voice(std::size_t slot, const AudioClip* clip, AudioCategory category,
+                              float gain, const Vec3& position, bool spatial) {
+    Voice& voice = voices_[slot];
+    voice.clip = clip;
+    voice.category = category;
+    voice.gain = sanitize_gain(gain);
+    voice.spatial = spatial;
+    voice.position = position;
+    voice.cursor = 0;
+    voice.serial = nextSerial_++;
+    voice.active = clip != nullptr && clip->frames() > 0;
+}
+
+void AudioEngine::stop_slot(std::size_t slot) {
+    voices_[slot].active = false;
+    voices_[slot].clip = nullptr;
+}
+
+void AudioEngine::stop_all_voices() {
+    for (Voice& voice : voices_) {
+        voice.active = false;
+        voice.clip = nullptr;
+        voice.cursor = 0;
+    }
+}
+
+void AudioEngine::warn_missing(const std::string& name) {
+    if (warnedMissing_.insert(name).second) {
+        std::fprintf(stderr, "sotc-viewer: audio: no clip named '%s'\n", name.c_str());
+    }
+}
+
+void AudioEngine::play(const std::string& name, const Vec3& position, float gain,
+                       bool spatial) {
+    const AudioClip* clip = find_clip(name);
+    if (clip == nullptr || clip->frames() == 0) {
+        warn_missing(name);
+        return;
+    }
+
+    std::size_t slot = static_cast<std::size_t>(kMaxVoices);
+    for (std::size_t i = kFirstSfxSlot; i < static_cast<std::size_t>(kMaxVoices); ++i) {
+        if (!voices_[i].active) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot == static_cast<std::size_t>(kMaxVoices)) {
+        // All SFX slots are busy: steal the oldest (smallest serial).
+        slot = kFirstSfxSlot;
+        for (std::size_t i = kFirstSfxSlot + 1; i < static_cast<std::size_t>(kMaxVoices);
+             ++i) {
+            if (voices_[i].serial < voices_[slot].serial) {
+                slot = i;
+            }
+        }
+    }
+    start_voice(slot, clip, AudioCategory::Sfx, gain, position, spatial);
+    // The device opens (and primes) on the first play, so headless timelines
+    // that never play never touch audio hardware.
+    ensure_device();
+}
+
+void AudioEngine::play_ui(const std::string& name, float gain) {
+    play(name, Vec3{0.0f, 0.0f, 0.0f}, gain, /*spatial=*/false);
+}
+
+void AudioEngine::play_music(const std::string& name, float gain) {
+    const AudioClip* clip = find_clip(name);
+    if (clip == nullptr || clip->frames() == 0) {
+        warn_missing(name);
+        return;
+    }
+    // Slot 0 is a single voice: a new cue replaces the current music.
+    start_voice(kMusicSlot, clip, AudioCategory::Music, gain, Vec3{0.0f, 0.0f, 0.0f},
+                /*spatial=*/false);
+    ensure_device();
+}
+
+void AudioEngine::stop_music() {
+    stop_slot(kMusicSlot);
+    // The prebuffer still holds the last ~50 ms of music; drop it so the stop
+    // is heard now rather than after the lead.
+    clear_stream();
+}
+
+void AudioEngine::play_ambience(const std::string& name, float gain) {
+    const AudioClip* clip = find_clip(name);
+    if (clip == nullptr || clip->frames() == 0) {
+        warn_missing(name);
+        return;
+    }
+    start_voice(kAmbienceSlot, clip, AudioCategory::Ambience, gain,
+                Vec3{0.0f, 0.0f, 0.0f}, /*spatial=*/false);
+    ensure_device();
+}
+
+void AudioEngine::reset() {
+    stop_all_voices();
+    clear_stream();
+}
+
+void AudioEngine::set_muted(bool muted) {
+    if (muted && !muted_) {
+        // Muting must not trail the prebuffer: drop it. Unmuting deliberately
+        // keeps the queue so the stream restarts without a priming gap.
+        clear_stream();
+    }
+    muted_ = muted;
+}
+
+int AudioEngine::active_voices() const {
+    int count = 0;
+    for (const Voice& voice : voices_) {
+        if (voice.active) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+bool AudioEngine::is_playing(const std::string& name) const {
+    const AudioClip* clip = find_clip(name);
+    if (clip == nullptr) {
+        return false;
+    }
+    for (const Voice& voice : voices_) {
+        if (voice.active && voice.clip == clip) {
+            return true;
+        }
+    }
+    return false;
+}
+
+int AudioEngine::queued_audio_bytes() const {
+    if (stream_ == nullptr) {
+        return 0;
+    }
+    const int queued = SDL_GetAudioStreamQueued(stream_);
+    return queued > 0 ? queued : 0;
+}
+
+void AudioEngine::mix(float* out, std::size_t frames, const Vec3& listenerPos,
+                      float listenerYawDeg) {
+    assert(frames * 2 <= mixBuffer_.size());
+    const std::size_t sample_count = frames * 2;
+    std::fill(out, out + sample_count, 0.0f);
+
+    // Yaw 0 looks along +Z, so the listener's right is forward x +Y.
+    const float yaw_radians = listenerYawDeg * kDegToRad;
+    const Vec3 right{-std::cos(yaw_radians), 0.0f, std::sin(yaw_radians)};
+
+    for (Voice& voice : voices_) {
+        if (!voice.active) {
+            continue;
+        }
+        const AudioClip* clip = voice.clip;
+        if (clip == nullptr || clip->frames() == 0) {
+            voice.active = false;
+            continue;
+        }
+
+        float gain = voice.gain * category_gain(voice.category);
+        float left_gain = gain;
+        float right_gain = gain;
+        if (voice.spatial) {
+            const Vec3 delta{voice.position.x - listenerPos.x,
+                             voice.position.y - listenerPos.y,
+                             voice.position.z - listenerPos.z};
+            const float distance = std::sqrt(vec3_dot(delta, delta));
+            gain *= 1.0f / (1.0f + distance / kReferenceDistance);
+            const Vec3 direction =
+                distance > 0.0f ? Vec3{delta.x / distance, delta.y / distance,
+                                       delta.z / distance}
+                                : Vec3{0.0f, 0.0f, 0.0f};
+            const float pan =
+                std::clamp(vec3_dot(right, direction), -1.0f, 1.0f) * kPanSpread;
+            // Constant-power pan: centre is -3 dB on each side, hard pan puts
+            // the energy on one channel.
+            const float angle = (pan + 1.0f) * (kPi / 4.0f);
+            left_gain = gain * std::cos(angle);
+            right_gain = gain * std::sin(angle);
+        }
+
+        const std::size_t clip_frames = clip->frames();
+        const int channels = clip->channels;
+        std::size_t cursor = voice.cursor;
+        for (std::size_t frame = 0; frame < frames; ++frame) {
+            if (cursor >= clip_frames) {
+                if (clip->loop) {
+                    cursor %= clip_frames;
+                } else {
+                    voice.active = false;
+                    break;
+                }
+            }
+            const float* source =
+                clip->samples.data() + cursor * static_cast<std::size_t>(channels);
+            const std::size_t out_index = frame * 2;
+            if (channels == 1) {
+                out[out_index] += source[0] * left_gain;
+                out[out_index + 1] += source[0] * right_gain;
+            } else {
+                out[out_index] += source[0] * left_gain;
+                out[out_index + 1] += source[1] * right_gain;
+            }
+            ++cursor;
+        }
+        voice.cursor = cursor;
+    }
+
+    if (muted_) {
+        std::fill(out, out + sample_count, 0.0f);
+        return;
+    }
+    // The output stage is the only place samples are clamped: a loud stack may
+    // saturate but never leaves the float WAV's [-1, 1] range. R14's 0.85
+    // master gain sits just before the clamp, so an ordinary music + SFX stack
+    // stays below the 0.99 delivery ceiling instead of square-waving.
+    for (std::size_t i = 0; i < sample_count; ++i) {
+        const float sample = out[i] * kMasterGain;
+        out[i] = std::isfinite(sample) ? std::clamp(sample, -1.0f, 1.0f) : 0.0f;
+    }
+}
+
+void AudioEngine::append_capture(std::size_t frames) {
+    if (!capturing_ || frames == 0) {
+        return;
+    }
+    assert(frames * 2 <= mixBuffer_.size());
+    capture_samples_.insert(capture_samples_.end(), mixBuffer_.begin(),
+                            mixBuffer_.begin() + static_cast<std::ptrdiff_t>(frames * 2));
+}
+
+bool AudioEngine::begin_capture(const std::string& path) {
+    last_error_.clear();
+    if (capturing_) {
+        last_error_ = path + ": a capture is already in progress";
+        return false;
+    }
+    if (path.empty()) {
+        last_error_ = "capture path is empty";
+        return false;
+    }
+    capture_path_ = path;
+    capture_samples_.clear();
+    capturing_ = true;
+    return true;
+}
+
+bool AudioEngine::end_capture() {
+    if (!capturing_) {
+        last_error_ = "no capture is in progress";
+        return false;
+    }
+    capturing_ = false;
+    std::string error;
+    if (!write_wav(capture_path_, capture_samples_, 2, 48000, &error)) {
+        last_error_ = error;
+        capture_path_.clear();
+        capture_samples_.clear();
+        return false;
+    }
+    capture_path_.clear();
+    capture_samples_.clear();
+    return true;
+}
+
+void AudioEngine::push_block(std::size_t frames) {
+    if (stream_ == nullptr || frames == 0) {
+        return;
+    }
+    assert(frames * 2 <= mixBuffer_.size());
+    mix(mixBuffer_.data(), frames, listenerPos_, listenerYawDeg_);
+    const int bytes = static_cast<int>(frames * 2 * sizeof(float));
+    if (!SDL_PutAudioStreamData(stream_, mixBuffer_.data(), bytes)) {
+        std::fprintf(stderr, "sotc-viewer: audio: stream push failed: %s\n",
+                     SDL_GetError());
+        SDL_DestroyAudioStream(stream_);
+        stream_ = nullptr;
+    }
+}
+
+void AudioEngine::top_up() {
+    // Keep ~3 blocks (50 ms) queued. Without this the 60 Hz producer supplies
+    // one block per frame against a ~20 ms device buffer and the beat between
+    // producer and consumer starves the stream (SDL pads silence: clicks).
+    for (int block = 0; stream_ != nullptr && block < kMaxTopUpBlocks; ++block) {
+        const int queued = SDL_GetAudioStreamQueued(stream_);
+        if (queued < 0 || queued >= kMaxQueuedBytes || queued >= kTargetQueuedBytes) {
+            return;
+        }
+        push_block(kBlockFrames);
+    }
+}
+
+void AudioEngine::clear_stream() {
+    if (stream_ != nullptr) {
+        SDL_ClearAudioStream(stream_);
+    }
+}
+
+void AudioEngine::ensure_device() {
+    if (capturing_) {
+        // A capture is a disk sink: never open hardware while it runs, even if
+        // a play was queued after begin_capture.
+        return;
+    }
+    if (deviceTried_) {
+        return;
+    }
+    deviceTried_ = true;
+
+    if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+        std::fprintf(stderr, "sotc-viewer: audio: SDL audio init failed: %s\n",
+                     SDL_GetError());
+        return;
+    }
+    device_ = SDL_OpenAudioDevice(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, nullptr);
+    if (device_ == 0) {
+        std::fprintf(stderr, "sotc-viewer: audio: no output device: %s\n", SDL_GetError());
+        return;
+    }
+    const SDL_AudioSpec source_format{SDL_AUDIO_F32, 2, 48000};
+    stream_ = SDL_CreateAudioStream(&source_format, nullptr);
+    if (stream_ == nullptr) {
+        std::fprintf(stderr, "sotc-viewer: audio: cannot create stream: %s\n",
+                     SDL_GetError());
+        SDL_CloseAudioDevice(device_);
+        device_ = 0;
+        return;
+    }
+    if (!SDL_BindAudioStreams(device_, &stream_, 1)) {
+        std::fprintf(stderr, "sotc-viewer: audio: cannot bind stream: %s\n",
+                     SDL_GetError());
+        SDL_DestroyAudioStream(stream_);
+        stream_ = nullptr;
+        SDL_CloseAudioDevice(device_);
+        device_ = 0;
+        return;
+    }
+    SDL_SetAudioStreamGain(stream_, 1.0f);
+    // Prime before the device has a chance to run dry: the lead contains the
+    // voice that just started (play* opens after the slot is filled).
+    top_up();
+}
+
+void AudioEngine::update(float dt, const Vec3& listenerPos, float listenerYawDeg) {
+    if (!std::isfinite(dt) || dt <= 0.0f) {
+        return;
+    }
+    listenerPos_ = listenerPos;
+    listenerYawDeg_ = std::isfinite(listenerYawDeg) ? listenerYawDeg : 0.0f;
+
+    const float clamped = std::min(dt, static_cast<float>(kMaxMixFrames) / 48000.0f);
+    const std::size_t frames = static_cast<std::size_t>(std::lround(clamped * 48000.0f));
+    if (frames == 0) {
+        return;
+    }
+    if (stream_ == nullptr || capturing_) {
+        // Nothing has played yet, or a capture owns the sink: the mixer still
+        // advances on the simulation clock, but no audio device is opened by a
+        // headless timeline.
+        mix(mixBuffer_.data(), frames, listenerPos_, listenerYawDeg_);
+        append_capture(frames);
+        return;
+    }
+    if (SDL_GetAudioStreamQueued(stream_) < kMaxQueuedBytes) {
+        push_block(frames);
+    } else {
+        // Backlog at the cap: keep the voices on the simulation clock and drop
+        // this block rather than grow the latency.
+        mix(mixBuffer_.data(), frames, listenerPos_, listenerYawDeg_);
+    }
+    append_capture(frames);
+    top_up();
+}
+
+bool AudioEngine::render_mixdown(const std::string& path, int seconds) {
+    last_error_.clear();
+    if (seconds <= 0 || seconds > kMixdownSecondsCap) {
+        last_error_ = path + ": mixdown seconds must be in [1, " +
+                      std::to_string(kMixdownSecondsCap) + "]";
+        return false;
+    }
+
+    const std::size_t total_frames =
+        static_cast<std::size_t>(seconds) * 48000u;
+    std::vector<float> samples;
+    samples.reserve(total_frames * 2);
+    for (std::size_t done = 0; done < total_frames;
+         done += static_cast<std::size_t>(kBlockFrames)) {
+        mix(mixBuffer_.data(), static_cast<std::size_t>(kBlockFrames), listenerPos_,
+            listenerYawDeg_);
+        const std::size_t produced = static_cast<std::size_t>(kBlockFrames) * 2;
+        samples.insert(samples.end(), mixBuffer_.begin(), mixBuffer_.begin() + produced);
+    }
+
+    std::string error;
+    if (!write_wav(path, samples, 2, 48000, &error)) {
+        last_error_ = error;
+        return false;
+    }
+    return true;
+}
diff --git a/app/src/audio.h b/app/src/audio.h
new file mode 100644
index 0000000..7d15274
--- /dev/null
+++ b/app/src/audio.h
@@ -0,0 +1,186 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "math3d.h"
+
+// S5 audio engine (design §7.4): a software mixer at 48 kHz float stereo that
+// reads the converter's R1 audio manifest (Task 3) and feeds one SDL3 audio
+// stream. The mix itself is pure math over preallocated buffers — no SDL call
+// and no allocation on the per-frame path — so `render_mixdown` drives exactly
+// what the device path pushes.
+//
+// The device is opened lazily on the first `update`; a failure stays silent and
+// logs once, never throwing. `render_mixdown` never opens a device.
+
+enum class AudioCategory { Music, Ambience, Sfx };
+
+// One decoded clip, interleaved float32 at 48 kHz. `loop` comes from the
+// manifest's `loop=` flag (the mixer wraps a cursor, not an SDL flag).
+struct AudioClip {
+    std::vector<float> samples;  // interleaved
+    int channels = 1;
+    int rate = 48000;
+    bool loop = false;
+
+    std::size_t frames() const {
+        return channels > 0 ? samples.size() / static_cast<std::size_t>(channels) : 0;
+    }
+};
+
+// Forwards the SDL audio types without pulling SDL into the mixer's header: the
+// engine only ever passes these handles through to audio.cpp.
+struct SDL_AudioStream;
+
+class AudioEngine {
+public:
+    // 32 voices: slot 0 music, slot 1 ambience, 2..31 SFX.
+    static constexpr int kMaxVoices = 32;
+    static constexpr int kMaxSfxVoices = kMaxVoices - 2;
+
+    // R14 headroom: the output stage scales the summed voices by 0.85 before
+    // the clamp. The shipped clips are normalized to 0.99, so the cue table's
+    // gains (music 0.45, most SFX 0.5-0.8) keep an ordinary music + SFX stack
+    // under the 0.99 delivery ceiling instead of square-waving. A per-voice gain
+    // is accepted up to 2.0 so the table can boost one clip (HurtHeavy's 1.25)
+    // and still be scaled by the master stage.
+    static constexpr float kMasterGain = 0.85f;
+    static constexpr float kMaxVoiceGain = 2.0f;
+
+    AudioEngine();
+    ~AudioEngine();
+    AudioEngine(const AudioEngine&) = delete;
+    AudioEngine& operator=(const AudioEngine&) = delete;
+
+    // Parses `manifestPath` (R1 `key=value` lines) and loads every entry's WAV
+    // from `libraryRoot + "/" + file`. A duplicate name, a malformed line, an
+    // absolute `file=` or a missing/unsupported file returns false with the
+    // offending name/path in `last_error()`; a parse/load failure is
+    // transactional (the previous clip set and voices stay untouched), while a
+    // missing manifest empties the engine and warns once. `gain_db` is
+    // provenance only (R12): the clip is never rescaled.
+    bool load_manifest(const std::string& manifestPath, const std::string& libraryRoot);
+
+    bool has(const std::string& name) const;
+    std::size_t clip_count() const { return clips_.size(); }
+
+    // World SFX. `spatial` true applies distance attenuation and pan; false
+    // plays centred. A voice at 0 m is unattenuated and centred. `gain` is
+    // clamped into [0, kMaxVoiceGain]; the category gain is applied on top.
+    void play(const std::string& name, const Vec3& position, float gain = 1.0f,
+              bool spatial = true);
+    // Centred SFX (UI/player-local) — same SFX pool as `play`.
+    void play_ui(const std::string& name, float gain = 1.0f);
+    // Slot 0; a second call replaces the current music.
+    void play_music(const std::string& name, float gain = 1.0f);
+    void stop_music();
+    // Slot 1; a second call replaces the current ambience.
+    void play_ambience(const std::string& name, float gain = 1.0f);
+
+    // Stops every voice (music included) and clears queued device audio; the
+    // mute state is kept.
+    void reset();
+    void set_muted(bool muted);
+    bool muted() const { return muted_; }
+
+    // Mixes `dt` seconds and tops up the device queue (the device itself opens
+    // on the first play* call). `dt` is clamped to [0, 1] s; a non-positive or
+    // non-finite dt is a no-op. The listener pose is remembered for
+    // `render_mixdown`.
+    void update(float dt, const Vec3& listenerPos, float listenerYawDeg);
+
+    // Runs the same mixer for `seconds` at dt = 1/60 (800 frames a step) and
+    // writes float32 stereo 48 kHz RIFF/WAVE to `path`. No device is opened.
+    // Uses the last listener pose passed to `update` (origin, yaw 0 by default).
+    bool render_mixdown(const std::string& path, int seconds);
+
+    // Headless capture (S5 Task 5): while capturing, every `update` appends the
+    // block it mixed to an internal buffer and no device is opened — a capture
+    // must work without hardware. `end_capture` writes the accumulated mix as a
+    // float32 stereo 48 kHz WAV and releases the buffer. Only one capture at a
+    // time; a second `begin_capture` fails.
+    bool begin_capture(const std::string& path);
+    bool end_capture();
+    bool capturing() const { return capturing_; }
+    std::size_t captured_frames() const { return capture_samples_.size() / 2; }
+
+    // Introspection for tests and acceptance: active voice count, whether any
+    // active voice plays `name`, the device queue lead in bytes (0 when no
+    // device is open), and the last load/mixdown failure.
+    int active_voices() const;
+    bool is_playing(const std::string& name) const;
+    int queued_audio_bytes() const;
+    const std::string& last_error() const { return last_error_; }
+
+private:
+    struct Voice {
+        const AudioClip* clip = nullptr;
+        AudioCategory category = AudioCategory::Sfx;
+        float gain = 1.0f;
+        bool spatial = true;
+        Vec3 position{};
+        std::size_t cursor = 0;  // frame index into the clip
+        std::uint64_t serial = 0;
+        bool active = false;
+    };
+
+    static constexpr std::size_t kMusicSlot = 0;
+    static constexpr std::size_t kAmbienceSlot = 1;
+    static constexpr std::size_t kFirstSfxSlot = 2;
+    // One second of headroom: `update` clamps dt here and the buffer is
+    // preallocated, so the per-frame mix never allocates.
+    static constexpr int kMaxMixFrames = 48000;
+    // 600 s covers the full 125.93 s `music.boss` with room to spare: the S5
+    // acceptance can dump a whole encounter without truncation.
+    static constexpr int kMixdownSecondsCap = 600;
+
+    void start_voice(std::size_t slot, const AudioClip* clip, AudioCategory category,
+                     float gain, const Vec3& position, bool spatial);
+    void stop_slot(std::size_t slot);
+    void stop_all_voices();
+    const AudioClip* find_clip(const std::string& name) const;
+
+    // The pure mix: sums every active voice into `out` (interleaved stereo,
+    // `frames` frames), applies category gain, attenuation/pan, mute, the
+    // master headroom gain and the [-1, 1] clamp, and advances the voices'
+    // cursors.
+    void mix(float* out, std::size_t frames, const Vec3& listenerPos,
+             float listenerYawDeg);
+    // Appends the block just mixed to the capture buffer (interleaved stereo).
+    void append_capture(std::size_t frames);
+
+    void ensure_device();
+    // Mixes one 800-frame block and pushes it to the bound stream. A failed
+    // push destroys the stream (the engine stays silent, already logged once).
+    void push_block(std::size_t frames);
+    // Keeps ~3 blocks (50 ms) queued so the device never starves between
+    // frames; bounded by the 0.5 s cap and a small iteration guard.
+    void top_up();
+    // Drops queued device audio, so mute/stop/reset take effect immediately
+    // instead of trailing the prebuffer.
+    void clear_stream();
+    void warn_missing(const std::string& name);
+
+    std::unordered_map<std::string, AudioClip> clips_;
+    std::vector<Voice> voices_;
+    std::vector<float> mixBuffer_;  // kMaxMixFrames * 2, allocated once
+    std::unordered_set<std::string> warnedMissing_;
+    Vec3 listenerPos_{0.0f, 0.0f, 0.0f};
+    float listenerYawDeg_ = 0.0f;
+    std::uint64_t nextSerial_ = 0;
+    bool muted_ = false;
+    bool deviceTried_ = false;
+    std::uint32_t device_ = 0;
+    SDL_AudioStream* stream_ = nullptr;
+    // Capture state: the sink path, the accumulated float stereo samples, and
+    // whether `update` should append instead of pushing to a device.
+    bool capturing_ = false;
+    std::string capture_path_;
+    std::vector<float> capture_samples_;
+    std::string last_error_;
+};
diff --git a/app/src/audio_events.h b/app/src/audio_events.h
new file mode 100644
index 0000000..4acc1b1
--- /dev/null
+++ b/app/src/audio_events.h
@@ -0,0 +1,163 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+#include "math3d.h"
+#include "player_state.h"
+#include "valus.h"
+
+// The S5 sound seam (design §7.4): the simulation never calls SDL. The player
+// state machine and the app's encounter helpers only report what changed; this
+// header turns those reports into a small fixed-capacity cue queue that the app
+// drains once per frame. Pure data and arithmetic — no SDL, no I/O, no
+// allocation — so the headless tests and the acceptance timeline drive exactly
+// the translation the interactive loop uses.
+//
+// The same queue is translated by one app-side function (cue_for + play), which
+// is what keeps the interactive loop and the shared scripted timeline from
+// drifting apart.
+
+enum class Sfx : std::uint16_t {
+    Strike,
+    StrikeHit,
+    Grab,
+    GripBreak,
+    Land,
+    HurtLight,
+    HurtHeavy,
+    Death,
+    StompStart,
+    StompImpact,
+    ClubStart,
+    ClubImpact,
+    ClubCancel,
+    ValusReaction,
+    ValusDefeat,
+    FootLeft,
+    FootRight,
+    Reset,
+    Count
+};
+
+// One cue. `gain` scales the cue table's own gain; `spatial` selects a world
+// voice (distance attenuation and pan) or a centred one; `position` is the
+// world anchor a spatial cue is attenuated from.
+struct SfxEvent {
+    Sfx id = Sfx::Count;
+    float gain = 1.0f;
+    Vec3 position{};
+    bool spatial = false;
+};
+
+// The fixed pool a frame's cues accumulate in. A 64-cue step is far beyond a
+// real frame (the whole fight emits a handful per frame); overflow drops the
+// extra cue rather than growing, so the per-frame path never allocates.
+struct SfxQueue {
+    static constexpr int kCapacity = 64;
+    std::array<SfxEvent, kCapacity> items{};
+    int count = 0;
+
+    void push(const SfxEvent& event) {
+        if (count >= kCapacity) {
+            return;
+        }
+        items[static_cast<std::size_t>(count)] = event;
+        ++count;
+    }
+
+    void clear() { count = 0; }
+    bool empty() const { return count == 0; }
+};
+
+// The encounter transitions the app reports. The plan's one-argument
+// `Encounter` snapshot cannot tell a telegraph from an impact, or a cancel from
+// a defeat; the app knows which transition it just made, so it names it.
+enum class EncounterSfx : std::uint8_t {
+    StompStart,
+    StompImpact,
+    ClubStart,
+    ClubImpact,
+    ClubCancel,
+    ValusReaction,
+    ValusDefeat,
+    Reset
+};
+
+// Appends the cue an encounter transition banks. All encounter cues are world
+// sounds: `at` is the entity's (or the striking joint's) world position.
+void append_encounter_sfx(EncounterSfx event, const Vec3& at, SfxQueue& out);
+
+// Appends one step's player cues. `playerPosition` anchors the spatial ones
+// (a landed hit, hurt, death); the swing itself is centred and always audible.
+// Nothing is appended for a step that reported nothing.
+void append_player_sfx(const StepEvents& events, const Vec3& playerPosition, SfxQueue& out);
+
+// --- Definitions (header-only: the seam has no translation unit) -------------
+
+inline void append_encounter_sfx(EncounterSfx event, const Vec3& at, SfxQueue& out) {
+    Sfx id = Sfx::Count;
+    switch (event) {
+        case EncounterSfx::StompStart:
+            id = Sfx::StompStart;
+            break;
+        case EncounterSfx::StompImpact:
+            id = Sfx::StompImpact;
+            break;
+        case EncounterSfx::ClubStart:
+            id = Sfx::ClubStart;
+            break;
+        case EncounterSfx::ClubImpact:
+            id = Sfx::ClubImpact;
+            break;
+        case EncounterSfx::ClubCancel:
+            id = Sfx::ClubCancel;
+            break;
+        case EncounterSfx::ValusReaction:
+            id = Sfx::ValusReaction;
+            break;
+        case EncounterSfx::ValusDefeat:
+            id = Sfx::ValusDefeat;
+            break;
+        case EncounterSfx::Reset:
+            id = Sfx::Reset;
+            break;
+    }
+    if (id == Sfx::Count) {
+        return;
+    }
+    out.push(SfxEvent{id, 1.0f, at, /*spatial=*/true});
+}
+
+inline void append_player_sfx(const StepEvents& events, const Vec3& playerPosition,
+                              SfxQueue& out) {
+    // The swing first: when a strike lands, its whoosh is the downbeat and the
+    // hit is the accent.
+    if (events.struck) {
+        out.push(SfxEvent{Sfx::Strike, 1.0f, playerPosition, /*spatial=*/false});
+    }
+    if (events.damageDealt > 0) {
+        // The state machine reports a landed shell hit as its one damage
+        // event; a whiff carries no damage and only the swing.
+        out.push(SfxEvent{Sfx::StrikeHit, 1.0f, playerPosition, /*spatial=*/true});
+    }
+    if (events.hurtLight) {
+        out.push(SfxEvent{Sfx::HurtLight, 1.0f, playerPosition, /*spatial=*/true});
+    }
+    if (events.hurtHeavy) {
+        out.push(SfxEvent{Sfx::HurtHeavy, 1.0f, playerPosition, /*spatial=*/true});
+    }
+    if (events.died) {
+        out.push(SfxEvent{Sfx::Death, 1.0f, playerPosition, /*spatial=*/true});
+    }
+    if (events.grabbed) {
+        out.push(SfxEvent{Sfx::Grab, 1.0f, playerPosition, /*spatial=*/false});
+    }
+    if (events.gripBroke) {
+        out.push(SfxEvent{Sfx::GripBreak, 1.0f, playerPosition, /*spatial=*/false});
+    }
+    if (events.landed) {
+        out.push(SfxEvent{Sfx::Land, 1.0f, playerPosition, /*spatial=*/false});
+    }
+}
diff --git a/app/src/audio_map.h b/app/src/audio_map.h
new file mode 100644
index 0000000..3110ff9
--- /dev/null
+++ b/app/src/audio_map.h
@@ -0,0 +1,131 @@
+#pragma once
+
+#include <cstddef>
+
+#include "audio_events.h"
+
+// The S5 cue table: the curated `Sfx` -> shipped manifest clip mapping (design
+// §7.3/§7.4, ruling R15). The table is deliberately narrow — the first slice is
+// the attribution gate's seven cues plus the fight music. A null cue is a
+// deferred event, not a missing one: grabbing, the grip break, landing, the
+// club cancel, Valus's defeat, footsteps and the reset are silent in S5.
+//
+// The names are the R1 manifest's `name=` values, loaded once at start. Every
+// non-null clip must exist in the loaded manifest: `missing_cue` names the
+// first offending `Sfx`, and the app turns that into a load error (fatal in
+// --s5-selftest, one warning and a silent game in interactive play).
+
+struct SoundCue {
+    const char* clip;  // manifest name, never null for a mapped cue
+    float gain;        // fractional voice gain (HurtHeavy is a 1.25 boost)
+    bool loop;         // the clip's own loop flag is authoritative; informational
+};
+
+// The fight music is not an `Sfx`: the app owns its lifecycle through
+// AudioEngine::play_music / stop_music (D5: starts on the first landed hit,
+// loops, stops on defeat and reset).
+inline constexpr const char* kMusicClip = "music.boss";
+inline constexpr float kMusicGain = 0.45f;
+
+namespace audio_map_detail {
+
+// Indexed by `Sfx`; the order is the enum's and the static_assert keeps them in
+// step. A nullptr clip is a deliberately deferred event.
+inline constexpr SoundCue kCues[] = {
+    {"player.swing", 0.60f, false},    // Strike: Wander's swing
+    {"player.hit", 0.60f, false},      // StrikeHit: the blade landing
+    {nullptr, 1.00f, false},           // Grab: deferred
+    {nullptr, 1.00f, false},           // GripBreak: deferred
+    {nullptr, 1.00f, false},           // Land: deferred
+    {"player.hurt", 1.00f, false},     // HurtLight
+    {"player.hurt", 1.25f, false},     // HurtHeavy: the same clip, pushed
+    {"player.death", 0.80f, false},    // Death
+    {"valus.telegraph", 0.60f, false},  // StompStart
+    {"valus.impact", 0.50f, false},     // StompImpact
+    {"valus.telegraph", 0.60f, false},  // ClubStart
+    {"valus.impact", 0.50f, false},     // ClubImpact
+    {nullptr, 1.00f, false},            // ClubCancel: deferred
+    {"valus.hurt", 0.60f, false},       // ValusReaction
+    {nullptr, 1.00f, false},            // ValusDefeat: deferred
+    {nullptr, 1.00f, false},            // FootLeft: deferred
+    {nullptr, 1.00f, false},            // FootRight: deferred
+    {nullptr, 1.00f, false},            // Reset: deferred
+};
+
+static_assert(sizeof(kCues) / sizeof(kCues[0]) == static_cast<std::size_t>(Sfx::Count),
+              "the cue table must cover every Sfx");
+
+}  // namespace audio_map_detail
+
+// The cue for `id`, or nullptr when the event is deliberately silent (or `id`
+// is Count/out of range).
+inline const SoundCue* cue_for(Sfx id) {
+    const std::size_t index = static_cast<std::size_t>(id);
+    if (index >= static_cast<std::size_t>(Sfx::Count)) {
+        return nullptr;
+    }
+    const SoundCue& cue = audio_map_detail::kCues[index];
+    return cue.clip == nullptr ? nullptr : &cue;
+}
+
+// The stable lowercase token the `s5-event` log uses (`strike`, `hurt_heavy`,
+// `valus_reaction`, ...), and `unknown` for Count/out of range.
+inline const char* sfx_name(Sfx id) {
+    switch (id) {
+        case Sfx::Strike:
+            return "strike";
+        case Sfx::StrikeHit:
+            return "strike_hit";
+        case Sfx::Grab:
+            return "grab";
+        case Sfx::GripBreak:
+            return "grip_break";
+        case Sfx::Land:
+            return "land";
+        case Sfx::HurtLight:
+            return "hurt_light";
+        case Sfx::HurtHeavy:
+            return "hurt_heavy";
+        case Sfx::Death:
+            return "death";
+        case Sfx::StompStart:
+            return "stomp_start";
+        case Sfx::StompImpact:
+            return "stomp_impact";
+        case Sfx::ClubStart:
+            return "club_start";
+        case Sfx::ClubImpact:
+            return "club_impact";
+        case Sfx::ClubCancel:
+            return "club_cancel";
+        case Sfx::ValusReaction:
+            return "valus_reaction";
+        case Sfx::ValusDefeat:
+            return "valus_defeat";
+        case Sfx::FootLeft:
+            return "foot_left";
+        case Sfx::FootRight:
+            return "foot_right";
+        case Sfx::Reset:
+            return "reset";
+        case Sfx::Count:
+            break;
+    }
+    return "unknown";
+}
+
+// The first `Sfx` whose non-null cue names a clip `has_clip` rejects, or
+// `Sfx::Count` when the loaded manifest satisfies the whole table. The app
+// reports that `Sfx` by name, so a missing clip fails as an event, not as an
+// anonymous file.
+template <typename HasClip>
+Sfx missing_cue(const HasClip& has_clip) {
+    for (int i = 0; i < static_cast<int>(Sfx::Count); ++i) {
+        const Sfx id = static_cast<Sfx>(i);
+        const SoundCue* cue = cue_for(id);
+        if (cue != nullptr && !has_clip(cue->clip)) {
+            return id;
+        }
+    }
+    return Sfx::Count;
+}
