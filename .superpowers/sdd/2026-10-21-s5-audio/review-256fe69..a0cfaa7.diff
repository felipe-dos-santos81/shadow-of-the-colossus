+def simple_operand(buf, pos):
+    """Decode a 0x00/0x10 (decimal) PLAY_TONE operand; None for complex types."""
+    if pos >= len(buf):
+        return None
+    b0 = buf[pos]
+    typ = b0 >> 4
+    n = b0 & 0x0F
+    if typ not in (0, 1) or n == 0 or pos + n >= len(buf):
+        return None
+    value = 0
+    for k in range(n):
+        x = buf[pos + 1 + k]
+        value = (x & 0x0F) + value * 100 + (x >> 4) * 10
+    return -value if typ == 1 else value
