+/// <summary>
+/// The one decode entry point for the S5 audio slice (recon §4-§8, the C# counterpart of the
+/// approved <c>s5_decode_gate.py</c> paths):
+/// <list type="bullet">
+/// <item><c>0x21</c> (and its <c>0x00FF____</c> forms) — PS-ADPCM, 16-byte blocks of 28
+/// samples, the gate's 8-filter predictor table (filters 5-7 fitted, see <see cref="VagCoefficients"/>).</item>
+/// <item><c>0x42</c>/<c>0x0142</c>/<c>0x0242</c>/<c>0x0642</c> — ATRAC9 through <c>ffmpeg</c>
+/// with the record's own big-endian config word as extradata.</item>
+/// </list>
+/// A 6-channel clip is downmixed to stereo and every normalized clip peaks at ≤ 0.99. A rejected
+/// format/config or a non-finite sample throws <see cref="InvalidDataException"/>; there is no
+/// silent fallback.
+/// </summary>
+/// <remarks>
+/// <para>
+/// <c>ffmpeg</c> (with its built-in <c>atrac9</c> decoder) is a converter-time subprocess, never
+/// a runtime dependency of the viewer. Override its path with <c>FFMPEG</c>; the default is
+/// <c>ffmpeg</c> on <c>PATH</c>. The wrapper is the gate's exact
+/// <c>WAVEFORMATEXTENSIBLE</c> layout: AT9 GUID, <c>block_align = frame_bytes &lt;&lt;
+/// superframe</c>, and 12 bytes of extradata (<c>LE32 0</c> + the 4 config bytes + 4 zeros).
+/// </para>
+/// <para>
+/// The PS-ADPCM predictor table is the standard VAG table for filters 0-4 plus the coefficients
+/// fitted in Task 1 for filters 5-7 (they live in the NGS2 firmware, not in <c>eboot.elf</c>).
+/// The fitted entries are a documented fidelity compromise, not a firmware proof: the user's ear
+/// is the final identity/fidelity check for the <c>0x21</c> cues (recon §7.2).
+/// </para>
+/// </remarks>
+public static class AudioCodec
+{
+    /// <summary>The normalized peak ceiling (ruling R6: the mixer can never clip).</summary>
+    public const double PeakCeiling = 0.99;
+
+    /// <summary>The standard VAG predictor table plus the fitted filters 5-7 (recon §7.2).</summary>
+    public static readonly IReadOnlyList<(int C1, int C2)> VagCoefficients = new (int, int)[]
+    {
+        (0, 0), (60, 0), (115, -52), (98, -55), (122, -60),
+        (126, -62), (128, -64), (126, -63),
+    };
+
+    /// <summary>AT9 <c>fmt</c>-chunk GUID (<c>d242e147-ba36-8d4d-88fc-61654f8c836c</c>).</summary>
+    private static readonly byte[] At9Guid =
+        Convert.FromHexString("d242e147ba368d4d88fc61654f8c836c");
+
+    private const int PsAdpcmBlockBytes = 16;
+    private const int PsAdpcmSamplesPerBlock = 28;
+    private const int PsAdpcmCoefficientShift = 6;
+    private const float DownmixCenter = 0.707f;
+    private const float DownmixSurround = 0.5f;
+    private const int FfmpegTimeoutMs = 120_000;
+
+    /// <summary>
+    /// Decodes one carved wave payload.
+    /// </summary>
+    /// <param name="payload">Exactly the record's <c>+0x20</c> byte range (no padding, no header).</param>
+    /// <param name="formatWord">
+    /// The record's <c>+0x04</c> word: low byte = codec id, byte 1 = channel count.
+    /// </param>
+    /// <param name="codecConfig">
+    /// The record's AT9 config word (<c>WaveRecord.CodecConfig</c>); required for the <c>0x42</c>
+    /// family, ignored by PS-ADPCM.
+    /// </param>
+    /// <param name="sampleRate">The record's <c>+0x08</c> rate (48 000 on every shipped wave).</param>
+    /// <param name="normalize">
+    /// True (the public contract) scales the clip to peak ≤ 0.99 and records the gain. The audio
+    /// verb passes false so that layers are mixed at their decoded level and normalized once.
+    /// </param>
+    /// <exception cref="InvalidDataException">
+    /// The format word names an unsupported codec/channel count, the AT9 config is missing or
+    /// disagrees with the record, <c>ffmpeg</c> fails, or the decoded PCM is empty/non-finite.
+    /// </exception>
+    public static DecodedAudio Decode(
+        ReadOnlySpan<byte> payload, uint formatWord, uint codecConfig, uint sampleRate,
+        bool normalize = true)
+    {
+        if (payload.Length == 0)
+            throw Reject("empty payload");
+        if (sampleRate == 0 || sampleRate > int.MaxValue)
+            throw Reject($"sample rate {sampleRate} is not a valid rate");
+
+        var codec = formatWord & 0xFF;
+        var channels = (int)((formatWord >> 8) & 0xFF);
+        var rate = (int)sampleRate;
+
+        var decoded = codec switch
+        {
+            0x21 => DecodePsAdpcm(payload, channels, rate),
+            0x42 => DecodeAt9(payload, channels, rate, codecConfig),
+            _ => throw Reject($"format 0x{formatWord:X8} has codec 0x{codec:X2}, which has no decoder"),
+        };
+
+        ValidateFinite(decoded);
+        return normalize ? Normalize(decoded) : decoded;
+    }
+
+    /// <summary>
+    /// Scales a clip to peak ≤ <see cref="PeakCeiling"/> and records the applied gain in dB. A
+    /// clip already at/below the ceiling is returned unchanged with <c>GainDb = 0</c>. The scaled
+    /// output is clamped to [-1, 1] as a final safety, which is a no-op after the ceiling scale.
+    /// </summary>
+    /// <exception cref="InvalidDataException">The clip contains a NaN/Inf sample.</exception>
+    public static DecodedAudio Normalize(DecodedAudio audio)
+    {
+        ArgumentNullException.ThrowIfNull(audio);
+        ValidateFinite(audio);
+
+        var peak = audio.Peak;
+        if (peak <= (float)PeakCeiling)
+            return audio with { GainDb = 0 };
+
+        var gain = PeakCeiling / peak;
+        var samples = new float[audio.Samples.Length];
+        for (var i = 0; i < samples.Length; i++)
+            samples[i] = Math.Clamp((float)(audio.Samples[i] * gain), -1f, 1f);
+
+        return audio with { Samples = samples, GainDb = 20.0 * Math.Log10(gain) };
+    }
+
+    /// <summary>
+    /// PS-ADPCM: 16-byte blocks (1 header byte <c>shift|filter&lt;&lt;4</c>, 1 flags byte, 14
+    /// nibble bytes → 28 samples). Stereo banks alternate the channels block by block; each
+    /// channel keeps its own predictor state. Exact port of the gate's <c>ps_adpcm_decode</c>.
+    /// </summary>
+    private static DecodedAudio DecodePsAdpcm(ReadOnlySpan<byte> data, int channels, int rate)
+    {
+        if (channels is not (1 or 2))
+            throw Reject($"PS-ADPCM supports 1 or 2 channels, the record says {channels}");
+
+        var blocks = data.Length / PsAdpcmBlockBytes;
+        var framesPerChannel = blocks / channels;
+        if (framesPerChannel == 0)
+            throw Reject(
+                $"PS-ADPCM payload {data.Length} B holds no complete {channels}-channel block");
+
+        var frames = framesPerChannel * PsAdpcmSamplesPerBlock;
+        var samples = new float[frames * channels];
+        var previous1 = new int[channels];
+        var previous2 = new int[channels];
+
+        for (var block = 0; block < framesPerChannel * channels; block++)
+        {
+            var offset = block * PsAdpcmBlockBytes;
+            var header = data[offset];
+            var shift = header & 0x0F;
+            var filter = (header >> 4) & 0x07;
+            var (c1, c2) = VagCoefficients[filter];
+            var channel = block % channels;
+            var s1 = previous1[channel];
+            var s2 = previous2[channel];
+            var frame = (block / channels) * PsAdpcmSamplesPerBlock;
+
+            for (var i = 2; i < PsAdpcmBlockBytes; i++)
+            {
+                var value = data[offset + i];
+                for (var half = 0; half < 2; half++)
+                {
+                    var nibble = half == 0 ? value & 0x0F : value >> 4;
+                    var v = nibble < 8 ? nibble << 12 : (nibble - 16) << 12;
+                    v >>= shift;
+                    var s = v + ((s1 * c1 + s2 * c2) >> PsAdpcmCoefficientShift);
+                    s = s < short.MinValue ? short.MinValue : (s > short.MaxValue ? short.MaxValue : s);
+                    s2 = s1;
+                    s1 = s;
+                    samples[(frame++) * channels + channel] = s / 32768f;
+                }
+            }
+
+            previous1[channel] = s1;
+            previous2[channel] = s2;
+        }
+
+        return new DecodedAudio(samples, channels, rate);
+    }
+
+    /// <summary>
+    /// ATRAC9 through <c>ffmpeg</c>, using the record's config word as extradata (recon §4.3).
+    /// </summary>
+    private static DecodedAudio DecodeAt9(
+        ReadOnlySpan<byte> data, int channels, int rate, uint codecConfig)
+    {
+        if (codecConfig == 0)
+            throw Reject("ATRAC9 record has no config word");
+        if (codecConfig >> 24 != 0xFE)
+            throw Reject($"ATRAC9 config 0x{codecConfig:X8} does not start with 0xFE");
+
+        var sampleRateIndex = (int)((codecConfig >> 20) & 0x0F);
+        var blockConfig = (int)((codecConfig >> 17) & 0x07);
+        var frameBytes = (int)((codecConfig >> 5) & 0x7FF) + 1;
+        var superframe = (int)((codecConfig >> 3) & 0x03);
+
+        if (sampleRateIndex != 7 || rate != 48000)
+            throw Reject(
+                $"ATRAC9 config 0x{codecConfig:X8} is sri {sampleRateIndex}, but the record is {rate} Hz (only 48 kHz/sri 7 is shipped)");
+        var configChannels = blockConfig switch
+        {
+            0 => 1,
+            1 or 2 => 2,
+            3 => 6,
+            4 => 8,
+            5 => 4,
+            _ => 0,
+        };
+        if (configChannels != channels)
+            throw Reject(
+                $"ATRAC9 config 0x{codecConfig:X8} is {configChannels}ch, but the record says {channels}ch");
+        if (superframe is not (0 or 2))
+            throw Reject($"ATRAC9 config 0x{codecConfig:X8} has superframe index {superframe}");
+        if (channels is not (1 or 2 or 6))
+            throw Reject($"ATRAC9 supports 1, 2 or 6 channels here, the record says {channels}");
+
+        var wrapper = BuildAt9Wrapper(data, channels, rate, frameBytes << superframe, codecConfig);
+        var directory = Path.Combine(
+            Path.GetTempPath(), $"bpconvert-at9-{Guid.NewGuid():N}");
+        Directory.CreateDirectory(directory);
+        try
+        {
+            var input = Path.Combine(directory, "carved.at9.wav");
+            var raw = Path.Combine(directory, "decoded.f32");
+            File.WriteAllBytes(input, wrapper);
+
+            RunFfmpeg(input, raw, channels);
+            var pcm = ReadFloats(raw, channels);
+            var decoded = new DecodedAudio(pcm, channels, rate);
+            if (channels == 6)
+                decoded = DownmixToStereo(decoded);
+            return decoded;
+        }
+        finally
+        {
+            try
+            {
+                Directory.Delete(directory, true);
+            }
+            catch (IOException)
+            {
+                // A leftover temp file is not a decode failure.
+            }
+            catch (UnauthorizedAccessException)
+            {
+            }
+        }
+    }
+
+    /// <summary>
+    /// The gate's <c>at9_riff_with_config</c>: 52-byte <c>WAVEFORMATEXTENSIBLE</c> with the AT9
+    /// GUID, mask, and 12-byte extradata, followed by one <c>data</c> chunk.
+    /// </summary>
+    private static byte[] BuildAt9Wrapper(
+        ReadOnlySpan<byte> payload, int channels, int rate, int blockAlign, uint codecConfig)
+    {
+        var mask = channels switch
+        {
+            1 => 0x4u,
+            2 => 0x3u,
+            4 => 0x33u,
+            6 => 0x3Fu,
+            8 => 0x63Fu,
+            _ => throw Reject($"no WAVEFORMATEXTENSIBLE mask for {channels} channels"),
+        };
+
+        const int extraDataLength = 12;
+        const int formatLength = 52;
+        var body = new byte[4 + 8 + formatLength + 8 + payload.Length];
+        var span = body.AsSpan();
+
+        "WAVE"u8.CopyTo(span);
+        "fmt "u8.CopyTo(span[4..]);
+        BinaryPrimitives.WriteUInt32LittleEndian(span[8..], formatLength);
+
+        var fmt = span[12..];
+        BinaryPrimitives.WriteUInt16LittleEndian(fmt, 0xFFFE); // WAVE_FORMAT_EXTENSIBLE
+        BinaryPrimitives.WriteUInt16LittleEndian(fmt[2..], (ushort)channels);
+        BinaryPrimitives.WriteUInt32LittleEndian(fmt[4..], (uint)rate);
+        BinaryPrimitives.WriteUInt32LittleEndian(fmt[8..], 0); // byte rate is unused by AT9
+        BinaryPrimitives.WriteUInt16LittleEndian(fmt[12..], (ushort)blockAlign);
+        BinaryPrimitives.WriteUInt16LittleEndian(fmt[14..], 0); // bits per sample
+        BinaryPrimitives.WriteUInt16LittleEndian(fmt[16..], 22 + extraDataLength);
+        BinaryPrimitives.WriteUInt16LittleEndian(fmt[18..], 0); // valid bits
+        BinaryPrimitives.WriteUInt32LittleEndian(fmt[20..], mask);
+        At9Guid.CopyTo(fmt[24..]);
+        // extradata: LE32 version 0 | 4 big-endian config bytes | 4 zero bytes
+        BinaryPrimitives.WriteUInt32LittleEndian(fmt[40..], 0);
+        BinaryPrimitives.WriteUInt32BigEndian(fmt[44..], codecConfig);
+        BinaryPrimitives.WriteUInt32LittleEndian(fmt[48..], 0);
+
+        var at = 12 + formatLength;
+        "data"u8.CopyTo(span[at..]);
+        BinaryPrimitives.WriteUInt32LittleEndian(span[(at + 4)..], (uint)payload.Length);
+        payload.CopyTo(span[(at + 8)..]);
+
+        // "RIFF" + the size of everything after it (the body is "WAVE" onward).
+        var riff = new byte[8 + body.Length];
+        "RIFF"u8.CopyTo(riff);
+        BinaryPrimitives.WriteUInt32LittleEndian(riff.AsSpan(4), (uint)body.Length);
+        body.CopyTo(riff, 8);
+        return riff;
+    }
+
+    /// <summary>Runs <c>ffmpeg</c> over the wrapper and leaves raw little-endian f32 samples.</summary>
+    private static void RunFfmpeg(string input, string output, int channels)
+    {
+        var executable = Environment.GetEnvironmentVariable("FFMPEG") ?? "ffmpeg";
+        var start = new ProcessStartInfo
+        {
+            FileName = executable,
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            UseShellExecute = false,
+        };
+        foreach (var argument in new[]
+                 {
+                     "-hide_banner", "-v", "error", "-y", "-i", input,
+                     "-map", "0:a", "-c:a", "pcm_f32le", "-f", "f32le", output,
+                 })
+            start.ArgumentList.Add(argument);
+
+        Process process;
+        try
+        {
+            process = Process.Start(start)
+                ?? throw new InvalidDataException("ffmpeg did not start");
+        }
+        catch (Win32Exception e)
+        {
+            throw Reject(
+                $"ATRAC9 needs '{executable}' on PATH (or FFMPEG); {e.Message}");
+        }
+        catch (InvalidOperationException e)
+        {
+            throw Reject($"ATRAC9 needs ffmpeg: {e.Message}");
+        }
+
+        using (process)
+        {
+            var error = process.StandardError.ReadToEndAsync();
+            process.StandardOutput.ReadToEnd(); // drain so the pipe cannot fill
+            if (!process.WaitForExit(FfmpegTimeoutMs))
+            {
+                try
+                {
+                    process.Kill(entireProcessTree: true);
+                }
+                catch (InvalidOperationException)
+                {
+                }
+
+                throw Reject($"ffmpeg timed out after {FfmpegTimeoutMs / 1000} s");
+            }
+
+            var stderr = error.GetAwaiter().GetResult().Trim();
+            if (process.ExitCode != 0)
+                throw Reject($"ffmpeg failed ({process.ExitCode}): {Tail(stderr)}");
+        }
+
+        if (!File.Exists(output))
+            throw Reject("ffmpeg produced no PCM");
+    }
+
+    /// <summary>Reads the raw f32le file and rejects a partial frame.</summary>
+    private static float[] ReadFloats(string path, int channels)
+    {
+        var bytes = File.ReadAllBytes(path);
+        if (bytes.Length == 0)
+            throw Reject("ffmpeg produced an empty PCM stream");
+        if (bytes.Length % (4 * channels) != 0)
+            throw Reject(
+                $"ffmpeg produced {bytes.Length} B, not whole {channels}-channel frames");
+
+        var samples = new float[bytes.Length / 4];
+        if (BitConverter.IsLittleEndian)
+        {
+            MemoryMarshal.Cast<byte, float>(bytes.AsSpan()).CopyTo(samples);
+        }
+        else
+        {
+            for (var i = 0; i < samples.Length; i++)
+                samples[i] = BinaryPrimitives.ReadSingleLittleEndian(bytes.AsSpan(4 * i));
+        }
+
+        return samples;
+    }
+
+    /// <summary>
+    /// 5.1 → stereo (ruling R6): <c>L' = L + 0.707·C + 0.5·LFE + 0.5·SL</c>,
+    /// <c>R' = R + 0.707·C + 0.5·LFE + 0.5·SR</c>. The channel order is the shipped AT9 5.1
+    /// layout (FL FR FC LFE SL SR).
+    /// </summary>
+    /// <remarks>
+    /// The sum is left unclipped on purpose. Every music master overshoots unity (recon §8) and
+    /// clamping the sum at [-1, 1] here hard-clips 2.36 % of Boss 1's stereo samples before
+    /// <see cref="Normalize"/> can attenuate them, which is exactly the distortion R6 exists to
+    /// avoid. <see cref="Normalize"/> brings the summed clip to peak 0.99 and clamps the final
+    /// output, so the delivered WAV is in range without pre-normalization clipping.
+    /// </remarks>
+    private static DecodedAudio DownmixToStereo(DecodedAudio audio)
+    {
+        var frames = audio.Frames;
+        var source = audio.Samples;
+        var stereo = new float[frames * 2];
+        for (var frame = 0; frame < frames; frame++)
+        {
+            var at = frame * 6;
+            stereo[frame * 2] = source[at] + DownmixCenter * source[at + 2]
+                + DownmixSurround * source[at + 3] + DownmixSurround * source[at + 4];
+            stereo[frame * 2 + 1] = source[at + 1] + DownmixCenter * source[at + 2]
+                + DownmixSurround * source[at + 3] + DownmixSurround * source[at + 5];
+        }
+
+        return new DecodedAudio(stereo, 2, audio.Rate);
+    }
+
+    private static void ValidateFinite(DecodedAudio audio)
+    {
+        if (audio.Channels is not (1 or 2))
+            throw Reject($"{audio.Channels} channels reached the output (only mono/stereo exist)");
+        if (audio.Rate <= 0)
+            throw Reject($"output rate {audio.Rate} Hz is not positive");
+        if (audio.Samples.Length % audio.Channels != 0)
+            throw Reject(
+                $"{audio.Samples.Length} samples do not form whole {audio.Channels}-channel frames");
+
+        for (var i = 0; i < audio.Samples.Length; i++)
+        {
+            if (!float.IsFinite(audio.Samples[i]))
+                throw Reject($"non-finite sample at frame {i / audio.Channels}, channel {i % audio.Channels}");
+        }
+    }
+
+    private static string Tail(string text)
+    {
+        const int limit = 400;
+        return text.Length <= limit ? text : text[^limit..];
+    }
+
+    private static InvalidDataException Reject(string detail) => new($"audio decode: {detail}");
+}
diff --git a/src/BpConvert.Core/Audio/AudioConverter.cs b/src/BpConvert.Core/Audio/AudioConverter.cs
new file mode 100644
index 0000000..6072443
--- /dev/null
+++ b/src/BpConvert.Core/Audio/AudioConverter.cs
@@ -0,0 +1,428 @@
+using System.Globalization;
+using System.Text.Json;
+
+namespace BpConvert.Core.Audio;
+
+/// <summary>One curated cue from <c>tools/re/audio/s5_map.json</c>.</summary>
+/// <param name="Event">The sound-request event key, e.g. <c>valus.impact</c> or <c>music.boss</c>.</param>
+/// <param name="Bank">The bank file stem (<c>boss01</c>, <c>music</c>, …).</param>
+/// <param name="Name">
+/// The request name (<c>NAME</c>/<c>REQD</c> namespace) for resident cues, or the <c>REQD</c>
+/// track name for music (<c>"Boss 1"</c>). Validated against the bank's own table.
+/// </param>
+/// <param name="Wave">The primary <c>WAVE</c> table index.</param>
+/// <param name="Layers">
+/// Every wave in the sound, primary included; <c>Layers[0] == Wave</c>. Mixed with equal gains
+/// from t=0 (the gate's <c>valus.impact</c> mix).
+/// </param>
+/// <param name="Loop">True for the streamed music track.</param>
+public sealed record AudioCue(
+    string Event, string Bank, string Name, int Wave, IReadOnlyList<int> Layers, bool Loop);
+
+/// <summary>
+/// The <c>audio</c> verb's inputs. <paramref name="Events"/> empty and <paramref name="Music"/>
+/// null means "the whole curated map".
+/// </summary>
+public sealed record AudioConvertOptions(
+    string Root, string OutLibrary, string MapPath, IReadOnlyList<string> Events, string? Music,
+    bool Force);
+
+/// <summary>What one run produced: the merged manifest entries, plus which cues were decoded.</summary>
+public sealed record AudioConvertResult(
+    IReadOnlyList<AudioEntry> Entries, IReadOnlyList<string> Written, IReadOnlyList<string> Reused,
+    string ManifestPath);
+
+/// <summary>
+/// The converter pipeline behind <c>bp-convert audio</c> (plan Task 3): read the curated map,
+/// resolve each cue's bank and <c>WAVE</c> record(s), carve with the loader formula, decode,
+/// mix layers, normalize, write <c>out/library/audio/&lt;bank&gt;/&lt;event&gt;.wav</c>, and merge the R1
+/// <c>audio.manifest</c>. Every failure is an <see cref="InvalidDataException"/> naming the event
+/// (the CLI turns it into exit 1).
+/// </summary>
+/// <remarks>
+/// <para>
+/// Resident payload: <c>wave_record_offset + 0x24 + start</c>, length <c>bytes</c>, inside the
+/// <c>DATA</c> body (recon §7.1, ruling R8). Music payload: <c>start</c> absolute in the
+/// companion <c>.sxd2</c> (recon §2). A range outside those regions is rejected as a non-tiling
+/// range, never clamped.
+/// </para>
+/// <para>
+/// Layers are decoded with <c>normalize: false</c> and summed with <c>1/N</c> gain from t=0,
+/// padded to the longest layer (the gate's mix), then downmixed (already done per layer) and
+/// normalized once, so the manifest's <c>gain_db</c> is the level the mixer actually sees.
+/// </para>
+/// </remarks>
+public static class AudioConverter
+{
+    private const int ResidentPayloadOffset = 0x24;
+    private const int StreamPayloadBase = 0x60;
+    private const double SilenceFloorRms = 1e-3; // the gate's -60 dBFS
+    private const string ManifestFileName = "audio.manifest";
+
+    /// <summary>Runs the conversion; idempotent unless <see cref="AudioConvertOptions.Force"/>.</summary>
+    /// <param name="options">Roots and scope.</param>
+    /// <param name="log">Optional one-line progress sink (the CLI passes <c>Console.WriteLine</c>).</param>
+    /// <exception cref="InvalidDataException">
+    /// The map is unreadable/incomplete, a selected event/music name is not in the map, a bank,
+    /// wave, name or payload is missing, a range does not tile, or a decode fails/silences.
+    /// </exception>
+    public static AudioConvertResult Run(AudioConvertOptions options, Action<string>? log = null)
+    {
+        ArgumentNullException.ThrowIfNull(options);
+        ArgumentException.ThrowIfNullOrWhiteSpace(options.Root);
+        ArgumentException.ThrowIfNullOrWhiteSpace(options.OutLibrary);
+        ArgumentException.ThrowIfNullOrWhiteSpace(options.MapPath);
+        ArgumentNullException.ThrowIfNull(options.Events);
+
+        var cues = Select(LoadMap(options.MapPath), options);
+        var manifestPath = Path.Combine(options.OutLibrary, "audio", ManifestFileName);
+
+        // The manifest is cumulative: a run scoped to one event must not drop the other entries.
+        var entries = new Dictionary<(string Bank, string Name), AudioEntry>();
+        if (File.Exists(manifestPath))
+            foreach (var entry in AudioManifest.Read(manifestPath))
+                entries[(entry.Bank, entry.Name)] = entry;
+
+        var banks = new Dictionary<string, BankContext>(StringComparer.Ordinal);
+        var written = new List<string>();
+        var reused = new List<string>();
+
+        foreach (var cue in cues)
+        {
+            var key = (cue.Bank, cue.Event);
+            if (!options.Force && entries.TryGetValue(key, out var existing)
+                && File.Exists(Path.Combine(options.OutLibrary,
+                    existing.File.Replace('/', Path.DirectorySeparatorChar))))
+            {
+                reused.Add(cue.Event);
+                log?.Invoke($"  reuse {cue.Bank}/{cue.Event}  {existing.Seconds:F3} s  "
+                    + $"{existing.Rate} Hz  gain {existing.GainDb:F2} dB");
+                continue;
+            }
+
+            var entry = ConvertCue(options, cue, banks);
+            entries[key] = entry;
+            written.Add(cue.Event);
+            log?.Invoke($"  write {cue.Bank}/{cue.Event}  {entry.Seconds:F3} s  "
+                + $"{entry.Rate} Hz {entry.Channels} ch  gain {entry.GainDb:F2} dB  ({entry.Codec})");
+        }
+
+        var merged = entries.Values
+            .OrderBy(entry => entry.Bank, StringComparer.Ordinal)
+            .ThenBy(entry => entry.Name, StringComparer.Ordinal)
+            .ToList();
+        AudioManifest.Write(manifestPath, merged);
+        log?.Invoke($"manifest: {manifestPath} ({merged.Count} entries)");
+        return new AudioConvertResult(merged, written, reused, manifestPath);
+    }
+
+    private static AudioEntry ConvertCue(
+        AudioConvertOptions options, AudioCue cue, Dictionary<string, BankContext> banks)
+    {
+        try
+        {
+            if (!banks.TryGetValue(cue.Bank, out var bank))
+            {
+                bank = LoadBank(options.Root, cue.Bank);
+                banks[cue.Bank] = bank;
+            }
+
+            ValidateName(bank, cue);
+
+            var layers = new List<DecodedAudio>(cue.Layers.Count);
+            var codecs = new HashSet<byte>();
+            foreach (var layer in cue.Layers)
+            {
+                if (layer < 0 || layer >= bank.Waves.Count)
+                    throw new InvalidDataException(
+                        $"wave {layer} is not in {bank.Bank.Path} (0..{bank.Waves.Count - 1})");
+                var wave = bank.Waves[layer];
+                var codec = (byte)(wave.FormatWord & 0xFF);
+                codecs.Add(codec);
+                if (codec == 0x42 && wave.CodecConfig == 0)
+                    throw new InvalidDataException(
+                        $"wave {layer} is ATRAC9 but has no config word at its record");
+                var payload = Carve(bank, wave);
+                layers.Add(AudioCodec.Decode(
+                    payload, wave.FormatWord, wave.CodecConfig, wave.SampleRate,
+                    normalize: false));
+            }
+
+            var rate = layers[0].Rate;
+            if (layers.Any(layer => layer.Rate != rate))
+                throw new InvalidDataException(
+                    "the layers disagree on sample rate: "
+                    + string.Join(", ", layers.Select(layer => layer.Rate).Distinct()));
+            var channels = layers.Max(layer => layer.Channels);
+            if (channels is not (1 or 2))
+                throw new InvalidDataException($"the mix has {channels} channels (the runtime is stereo)");
+
+            var mix = Mix(layers, channels);
+            var normalized = AudioCodec.Normalize(new DecodedAudio(mix, channels, rate));
+            if (normalized.Rms <= SilenceFloorRms)
+                throw new InvalidDataException(
+                    $"the decoded clip is silent (RMS {normalized.Rms:0.######})");
+
+            var entry = new AudioEntry(
+                cue.Bank, cue.Event, $"audio/{cue.Bank}/{cue.Event}.wav", rate, channels,
+                normalized.Frames, Canonical(normalized.Seconds, "F6"), CodecName(codecs),
+                cue.Loop, Canonical(normalized.GainDb, "0.####"));
+            var path = Path.Combine(options.OutLibrary,
+                entry.File.Replace('/', Path.DirectorySeparatorChar));
+            WavWriter.Write(path, normalized.Samples, normalized.Channels, normalized.Rate);
+            return entry;
+        }
+        catch (InvalidDataException e)
+        {
+            throw new InvalidDataException($"{cue.Event}: {e.Message}", e);
+        }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+        {
+            throw new InvalidDataException($"{cue.Event}: {e.Message}", e);
+        }
+    }
+
+    /// <summary>
+    /// Rounds to exactly what <see cref="AudioManifest"/> prints, so the in-memory entry and the
+    /// manifest line are the same value (the round-trip test compares records).
+    /// </summary>
+    private static double Canonical(double value, string format) =>
+        double.Parse(value.ToString(format, CultureInfo.InvariantCulture), CultureInfo.InvariantCulture);
+
+    /// <summary>Equal-gain mix from t=0, padded to the longest layer.</summary>
+    private static float[] Mix(IReadOnlyList<DecodedAudio> layers, int channels)
+    {
+        var frames = layers.Max(layer => layer.Frames);
+        var mix = new float[frames * channels];
+        var gain = 1f / layers.Count;
+        foreach (var layer in layers)
+        {
+            for (var frame = 0; frame < layer.Frames; frame++)
+            {
+                if (layer.Channels == channels)
+                {
+                    for (var channel = 0; channel < channels; channel++)
+                        mix[frame * channels + channel] +=
+                            layer.Samples[frame * layer.Channels + channel] * gain;
+                }
+                else
+                {
+                    // A mono layer feeds both channels of a stereo mix.
+                    var sample = layer.Samples[frame] * gain;
+                    for (var channel = 0; channel < channels; channel++)
+                        mix[frame * channels + channel] += sample;
+                }
+            }
+        }
+
+        return mix;
+    }
+
+    private static string CodecName(HashSet<byte> codecs) => codecs.Count == 1
+        ? codecs.Single() switch
+        {
+            0x21 => "psadpcm",
+            0x42 => "at9",
+            var other => $"0x{other:X2}",
+        }
+        : "mixed";
+
+    /// <summary>Carves one record's exact payload, rejecting a range outside the bank's region.</summary>
+    private static byte[] Carve(BankContext context, WaveRecord wave)
+    {
+        long start;
+        byte[] source;
+        long limitStart;
+        long limitEnd;
+        if (context.Bank.HasData)
+        {
+            start = wave.RecordOffset + ResidentPayloadOffset + wave.Start;
+            source = context.IndexBytes;
+            limitStart = context.Bank.DataOffset + 0x10;
+            limitEnd = context.Bank.DataOffset + 8 + context.Bank.DataSize;
+        }
+        else
+        {
+            start = wave.Start;
+            source = context.PayloadBytes
+                ?? throw new InvalidDataException(
+                    $"bank {context.Bank.Name} has no companion .sxd2 payload");
+            limitStart = StreamPayloadBase;
+            limitEnd = source.Length;
+        }
+
+        if (start < limitStart || start + wave.ByteLength > limitEnd)
+            throw new InvalidDataException(
+                $"wave {wave.Index} payload [{start:#x}, +{wave.ByteLength}) escapes "
+                + $"[{limitStart:#x}, {limitEnd:#x}) — the record does not tile the payload");
+        return source.AsSpan((int)start, wave.ByteLength).ToArray();
+    }
+
+    /// <summary>Reads a bank and validates the cue's name against its own naming table.</summary>
+    private static BankContext LoadBank(string root, string bankName)
+    {
+        var soundDir = Path.Combine(root, "sound", "shadow");
+        var residentPath = Path.Combine(soundDir, bankName + ".sxd");
+        var indexPath = Path.Combine(soundDir, bankName + ".sxd1");
+        string path;
+        if (File.Exists(residentPath))
+            path = residentPath;
+        else if (File.Exists(indexPath))
+            path = indexPath;
+        else
+            throw new InvalidDataException(
+                $"bank file not found: {residentPath} or {indexPath}");
+
+        var bank = SxdContainer.Read(path);
+        var waves = SxdTables.Waves(bank);
+        if (waves.Count == 0)
+            throw new InvalidDataException($"{path} has no WAVE records");
+
+        var context = new BankContext(path, bank, waves, File.ReadAllBytes(path));
+        if (bank.HasData)
+            context.Names = SxdTables.Names(bank)
+                .Select(record => record.Name)
+                .ToHashSet(StringComparer.Ordinal);
+        else
+            context.PayloadBytes = ReadCompanion(path);
+        return context;
+    }
+
+    private static byte[] ReadCompanion(string indexPath)
+    {
+        var payloadPath = Path.ChangeExtension(indexPath, ".sxd2");
+        if (!File.Exists(payloadPath))
+            throw new InvalidDataException($"companion payload not found: {payloadPath}");
+        return File.ReadAllBytes(payloadPath);
+    }
+
+    /// <summary>Resolves and cross-checks the cue's name against the bank's table.</summary>
+    private static void ValidateName(BankContext context, AudioCue cue)
+    {
+        if (context.Bank.HasData)
+        {
+            if (context.Names is null || !context.Names.Contains(cue.Name))
+                throw new InvalidDataException(
+                    $"name \"{cue.Name}\" is not in {context.Path}'s NAME table");
+            return;
+        }
+
+        context.TrackNames ??= SxdTables.TrackNames(context.Bank);
+        var tracks = context.TrackNames;        if (cue.Wave >= tracks.Count)
+            throw new InvalidDataException(
+                $"wave {cue.Wave} has no REQD track name (the bank has {tracks.Count})");
+        if (!string.Equals(tracks[cue.Wave], cue.Name, StringComparison.Ordinal))
+            throw new InvalidDataException(
+                $"wave {cue.Wave} is the track \"{tracks[cue.Wave]}\", not \"{cue.Name}\"");
+    }
+
+    private static List<AudioCue> Select(List<AudioCue> cues, AudioConvertOptions options)
+    {
+        if (options.Events.Count == 0 && options.Music is null)
+            return cues;
+
+        var selected = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var eventName in options.Events)
+        {
+            var cue = cues.FirstOrDefault(candidate => candidate.Event == eventName)
+                ?? throw new InvalidDataException(
+                    $"event '{eventName}' is not in {options.MapPath}");
+            selected.Add(cue.Event);
+        }
+
+        if (options.Music is not null)
+        {
+            var cue = cues.FirstOrDefault(candidate =>
+                    candidate.Bank == "music" && candidate.Name == options.Music)
+                ?? throw new InvalidDataException(
+                    $"music track '{options.Music}' is not in {options.MapPath}");
+            selected.Add(cue.Event);
+        }
+
+        return cues.Where(cue => selected.Contains(cue.Event)).ToList();
+    }
+
+    /// <summary>Reads the curated map (the Task 1 JSON schema, ruling R2).</summary>
+    private static List<AudioCue> LoadMap(string path)
+    {
+        using var document = JsonDocument.Parse(File.ReadAllText(path));
+        var root = document.RootElement;
+        if (root.ValueKind != JsonValueKind.Object
+            || !root.TryGetProperty("cues", out var cues)
+            || cues.ValueKind != JsonValueKind.Array)
+            throw new InvalidDataException($"{path}: no \"cues\" array");
+
+        var result = new List<AudioCue>();
+        var events = new HashSet<string>(StringComparer.Ordinal);
+        foreach (var element in cues.EnumerateArray())
+        {
+            var eventName = RequiredString(element, "event", path);
+            var bank = RequiredString(element, "bank", path);
+            var name = RequiredString(element, "name", path);
+            if (!element.TryGetProperty("wave", out var waveElement)
+                || !waveElement.TryGetInt32(out var wave) || wave < 0)
+                throw new InvalidDataException($"{path}: cue '{eventName}' has no valid wave index");
+            if (!events.Add(eventName))
+                throw new InvalidDataException($"{path}: duplicate cue event '{eventName}'");
+
+            var layers = new List<int>();
+            if (element.TryGetProperty("layers", out var layerElement))
+            {
+                if (layerElement.ValueKind != JsonValueKind.Array)
+                    throw new InvalidDataException($"{path}: cue '{eventName}' has a non-array layers");
+                foreach (var layer in layerElement.EnumerateArray())
+                {
+                    if (!layer.TryGetInt32(out var index) || index < 0)
+                        throw new InvalidDataException(
+                            $"{path}: cue '{eventName}' has a bad layer index");
+                    layers.Add(index);
+                }
+            }
+
+            if (layers.Count == 0)
+                layers.Add(wave);
+            if (layers[0] != wave)
+                throw new InvalidDataException(
+                    $"{path}: cue '{eventName}' must list its primary wave first in layers");
+            if (layers.Distinct().Count() != layers.Count)
+                throw new InvalidDataException($"{path}: cue '{eventName}' repeats a layer");
+
+            var loop = element.TryGetProperty("loop", out var loopElement)
+                && loopElement.ValueKind is JsonValueKind.True or JsonValueKind.False
+                    ? loopElement.GetBoolean()
+                    : bank == "music";
+            result.Add(new AudioCue(eventName, bank, name, wave, layers, loop));
+        }
+
+        return result;
+    }
+
+    private static string RequiredString(JsonElement element, string key, string path)
+    {
+        if (!element.TryGetProperty(key, out var value)
+            || value.ValueKind != JsonValueKind.String
+            || string.IsNullOrWhiteSpace(value.GetString()))
+            throw new InvalidDataException($"{path}: a cue is missing a non-empty \"{key}\"");
+        return value.GetString()!;
+    }
+
+    /// <summary>A bank opened once per run, with its payload and name table cached.</summary>
+    private sealed class BankContext
+    {
+        public BankContext(string path, SxdBank bank, IReadOnlyList<WaveRecord> waves, byte[] indexBytes)
+        {
+            Path = path;
+            Bank = bank;
+            Waves = waves;
+            IndexBytes = indexBytes;
+        }
+
+        public string Path { get; }
+        public SxdBank Bank { get; }
+        public IReadOnlyList<WaveRecord> Waves { get; }
+        public byte[] IndexBytes { get; }
+        public byte[]? PayloadBytes { get; set; }
+        public HashSet<string>? Names { get; set; }
+        public IReadOnlyList<string>? TrackNames { get; set; }
+    }
+}
diff --git a/src/BpConvert.Core/Audio/AudioManifest.cs b/src/BpConvert.Core/Audio/AudioManifest.cs
new file mode 100644
index 0000000..2d05830
--- /dev/null
+++ b/src/BpConvert.Core/Audio/AudioManifest.cs
@@ -0,0 +1,225 @@
+using System.Globalization;
+using System.Text;
+
+namespace BpConvert.Core.Audio;
+
+/// <summary>
+/// One line of <c>audio.manifest</c> (ruling R1): the decoded clip's identity, its WAV path
+/// relative to the library root, and the measured PCM facts. The viewer loads the manifest and
+/// never opens a <c>.sxd</c>.
+/// </summary>
+/// <param name="Bank">Source bank name, e.g. <c>boss01</c> or <c>music</c>.</param>
+/// <param name="Name">Clip name — the curated event key, e.g. <c>valus.impact</c>.</param>
+/// <param name="File">
+/// WAV path relative to the library root with forward slashes, e.g.
+/// <c>audio/boss01/valus.impact.wav</c>.
+/// </param>
+/// <param name="Rate">Measured sample rate (48 000).</param>
+/// <param name="Channels">1 or 2 (5.1 was downmixed at conversion time, ruling R6).</param>
+/// <param name="Frames">Measured per-channel frame count (not the record's declared count).</param>
+/// <param name="Seconds">Measured duration, <paramref name="Frames"/> / <paramref name="Rate"/>.</param>
+/// <param name="Codec">Source codec: <c>at9</c>, <c>psadpcm</c>, or <c>mixed</c> for a layer mix.</param>
+/// <param name="Loop">True for the streamed music tracks.</param>
+/// <param name="GainDb">
+/// The attenuation <see cref="AudioCodec.Normalize"/> applied when bringing the clip to peak
+/// ≤ 0.99 (0 when no scaling was needed). Informational: the WAV is already normalized.
+/// </param>
+public sealed record AudioEntry(
+    string Bank, string Name, string File, int Rate, int Channels, long Frames, double Seconds,
+    string Codec, bool Loop, double GainDb);
+
+/// <summary>
+/// Reads and writes the line-based <c>audio.manifest</c> (ruling R1):
+/// <code>
+/// version=1
+/// name=valus.impact bank=boss01 file=audio/boss01/valus.impact.wav rate=48000 channels=2 frames=362068 seconds=7.543083 codec=psadpcm loop=0 gain_db=-0.0864
+/// </code>
+/// One entry per line, keys in that order, sorted by <c>(bank, name)</c>. Values are
+/// space-free: the clip name is the curated event key, so the <c>key=value</c> pairs stay
+/// unambiguous for the viewer's simple parser. The first line is <c>version=1</c>; the path key is
+/// relative to the library root (<c>out/library</c>), which is exactly what
+/// <c>AudioEngine::load_manifest(manifestPath, libraryRoot)</c> receives.
+/// </summary>
+public static class AudioManifest
+{
+    /// <summary>The only manifest schema version this converter writes/reads.</summary>
+    public const int Version = 1;
+
+    private static readonly string[] Keys =
+    {
+        "name", "bank", "file", "rate", "channels", "frames", "seconds", "codec", "loop", "gain_db",
+    };
+
+    /// <summary>
+    /// Writes <paramref name="entries"/> sorted by <c>(bank, name)</c>, creating the parent
+    /// directory. Returns <paramref name="path"/> so a caller can log it directly.
+    /// </summary>
+    /// <exception cref="InvalidDataException">
+    /// A field is empty/out of range, a value contains whitespace (the line format is
+    /// space-separated), or two entries share a <c>(bank, name)</c> key.
+    /// </exception>
+    public static string Write(string path, IReadOnlyList<AudioEntry> entries)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(path);
+        ArgumentNullException.ThrowIfNull(entries);
+
+        var seen = new HashSet<(string Bank, string Name)>();
+        foreach (var entry in entries)
+        {
+            Validate(path, null, entry);
+            if (!seen.Add((entry.Bank, entry.Name)))
+                throw Invalid(path, $"duplicate entry {entry.Bank}/{entry.Name}");
+        }
+
+        var builder = new StringBuilder();
+        builder.Append("version=").Append(Version).Append('\n');
+        foreach (var entry in entries.OrderBy(entry => entry.Bank, StringComparer.Ordinal)
+                     .ThenBy(entry => entry.Name, StringComparer.Ordinal))
+        {
+            builder.Append("name=").Append(entry.Name)
+                .Append(" bank=").Append(entry.Bank)
+                .Append(" file=").Append(entry.File)
+                .Append(" rate=").Append(entry.Rate.ToString(CultureInfo.InvariantCulture))
+                .Append(" channels=").Append(entry.Channels.ToString(CultureInfo.InvariantCulture))
+                .Append(" frames=").Append(entry.Frames.ToString(CultureInfo.InvariantCulture))
+                .Append(" seconds=").Append(entry.Seconds.ToString("F6", CultureInfo.InvariantCulture))
+                .Append(" codec=").Append(entry.Codec)
+                .Append(" loop=").Append(entry.Loop ? '1' : '0')
+                .Append(" gain_db=").Append(entry.GainDb.ToString("0.####", CultureInfo.InvariantCulture))
+                .Append('\n');
+        }
+
+        var directory = Path.GetDirectoryName(Path.GetFullPath(path));
+        if (!string.IsNullOrEmpty(directory))
+            Directory.CreateDirectory(directory);
+        File.WriteAllText(path, builder.ToString(), new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
+        return path;
+    }
+
+    /// <summary>
+    /// Reads a manifest written by <see cref="Write"/> and returns its entries sorted by
+    /// <c>(bank, name)</c> (the on-disk order is already sorted; sorting here makes a hand-edited
+    /// file stable too).
+    /// </summary>
+    /// <exception cref="InvalidDataException">
+    /// The version line is missing/unknown, a line has an unknown/duplicate/missing key or an
+    /// unparsable value, or two entries share a <c>(bank, name)</c> key.
+    /// </exception>
+    public static IReadOnlyList<AudioEntry> Read(string path)
+    {
+        ArgumentException.ThrowIfNullOrWhiteSpace(path);
+
+        var lines = File.ReadAllLines(path);
+        var entries = new List<AudioEntry>(Math.Max(0, lines.Length - 1));
+        var seen = new HashSet<(string Bank, string Name)>();
+        var sawVersion = false;
+
+        for (var i = 0; i < lines.Length; i++)
+        {
+            var line = lines[i].Trim();
+            if (line.Length == 0)
+                continue;
+
+            if (!sawVersion)
+            {
+                if (line != $"version={Version}")
+                    throw Invalid(path, $"line {i + 1}: expected version={Version}, got \"{line}\"");
+                sawVersion = true;
+                continue;
+            }
+
+            var values = new Dictionary<string, string>(StringComparer.Ordinal);
+            foreach (var token in line.Split(' ', StringSplitOptions.RemoveEmptyEntries))
+            {
+                var equals = token.IndexOf('=');
+                if (equals <= 0 || equals == token.Length - 1)
+                    throw Invalid(path, $"line {i + 1}: \"{token}\" is not key=value");
+                var key = token[..equals];
+                if (Array.IndexOf(Keys, key) < 0)
+                    throw Invalid(path, $"line {i + 1}: unknown key \"{key}\"");
+                if (!values.TryAdd(key, token[(equals + 1)..]))
+                    throw Invalid(path, $"line {i + 1}: duplicate key \"{key}\"");
+            }
+
+            foreach (var key in Keys)
+                if (!values.ContainsKey(key))
+                    throw Invalid(path, $"line {i + 1}: missing key \"{key}\"");
